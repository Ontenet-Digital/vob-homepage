<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="{{ settings.color_violet_deep | default: '#412773' }}">
    <link rel="canonical" href="{{ canonical_url }}">

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}

    <title>
      {{ page_title }}
      {%- if current_tags %} &ndash; {{ 'general.meta.tags' | t: tags: current_tags | join: ', ' }}{% endif -%}
      {%- if current_page != 1 %} &ndash; {{ 'general.meta.page' | t: page: current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>

    {%- if page_description -%}
      <meta name="description" content="{{ page_description | escape }}">
    {%- endif -%}

    {{ content_for_header }}
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cardo:ital,wght@0,400;0,700;1,400&family=Fraunces:ital,opsz,wght@0,9..144,300..700;1,9..144,400..600&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://unpkg.com/lenis@1.3.26/dist/lenis.css">
    
    {{ 'theme.css' | asset_url | stylesheet_tag }}
    {{ 'header.css' | asset_url | stylesheet_tag }}
    {{ 'hero.css' | asset_url | stylesheet_tag }}
    {{ 'about.css' | asset_url | stylesheet_tag }}
    {{ 'categories.css' | asset_url | stylesheet_tag }}
    {{ 'video-section.css' | asset_url | stylesheet_tag }}
    {{ 'video-banner.css' | asset_url | stylesheet_tag }}
    {{ 'app-section.css' | asset_url | stylesheet_tag }}
    {{ 'story-section.css' | asset_url | stylesheet_tag }}
    {{ 'story-pages.css' | asset_url | stylesheet_tag }}
    {{ 'testimonial-section.css' | asset_url | stylesheet_tag }}
    {{ 'usp-section.css' | asset_url | stylesheet_tag }}
    {{ 'footer.css' | asset_url | stylesheet_tag }}
    {{ 'standard-pages.css' | asset_url | stylesheet_tag }}
    {{ 'policy-pages.css' | asset_url | stylesheet_tag }}
    {{ 'contact-form.css' | asset_url | stylesheet_tag }}
    {{ 'best-seller.css' | asset_url | stylesheet_tag }}
    {{ 'product-list.css' | asset_url | stylesheet_tag }}
    {{ 'featured-product.css' | asset_url | stylesheet_tag }}
    {{ 'cart-drawer.css' | asset_url | stylesheet_tag }}
    {{ 'main-product.css' | asset_url | stylesheet_tag }}


    <script src="https://unpkg.com/lenis@1.3.26/dist/lenis.min.js" defer></script> 

    <style>
      :root{
        --parchment:{{ settings.color_parchment | default: '#FFFFFF' }};
        --ink:{{ settings.color_ink | default: '#251D3A' }};
        --ink-soft:{{ settings.color_ink_soft | default: '#463C68' }};
        --violet-deep:{{ settings.color_violet_deep | default: '#412773' }};
        --violet:{{ settings.color_violet | default: '#7A57C0' }};
        --gold:{{ settings.color_gold | default: '#BE9743' }};
        --gold-bright:{{ settings.color_gold_bright | default: '#E4C56C' }};
        --gold-deep:{{ settings.color_gold_deep | default: '#7C5D1E' }};
        --wrap-hd:{{ settings.layout_wrap_hd | default: 768 | append: 'px' }};
        --wrap-hdplus:{{ settings.layout_wrap_hdplus | default: 1024 | append: 'px' }};
        --wrap-qhd:{{ settings.layout_wrap_qhd | default: 1280 | append: 'px' }};
        --wrap-fhd:{{ settings.layout_wrap_fhd | default: 1440 | append: 'px' }};
        --wrap-2k:{{ settings.layout_wrap_2k | default: 1920 | append: 'px' }};
        --gutter-tab:{{ settings.layout_gutter_tab | default: 24 | append: 'px' }};
        --gutter-mobile:{{ settings.layout_gutter_mobile | default: 16 | append: 'px' }};
      }
    </style>
  </head>

  <body class="template-{{ request.page_type | handle }}">

    {% section 'header' %}

    {% section 'cart-drawer' %}

    <main id="top" role="main">
      {{ content_for_layout }}
    </main>

    {% section 'footer' %}

    <script src="{{ 'theme.js' | asset_url }}" defer></script>
    <script src="{{ 'theme-nav.js' | asset_url }}" defer></script>
    <script src="{{ 'theme-reveal.js' | asset_url }}" defer></script>
    <script src="{{ 'theme-about.js' | asset_url }}" defer></script>
    <script src="{{ 'theme-video.js' | asset_url }}" defer></script>
    <script src="{{ 'theme-testimonial.js' | asset_url }}" defer></script>
    <script src="{{ 'theme-filters.js' | asset_url }}" defer></script>
    <script src="{{ 'theme-cart.js' | asset_url }}" defer></script>
    <script src="{{ 'theme-sort.js' | asset_url }}" defer></script>
    <script src="{{ 'theme-fill.js' | asset_url }}" defer></script>
    <script src="{{ 'theme-contact.js' | asset_url }}" defer></script>
    <script src="{{ 'main-product.js' | asset_url }}" defer></script>
    <script src="{{ 'theme-policy.js' | asset_url }}" defer></script>
  </body>
</html>
