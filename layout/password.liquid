<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="canonical" href="{{ canonical_url }}">
    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}
    <title>{{ shop.name }}</title>
    {%- if page_description -%}<meta name="description" content="{{ page_description | escape }}">{%- endif -%}
    {{ content_for_header }}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cardo:ital,wght@0,400;0,700;1,400&family=Fraunces:ital,opsz,wght@0,9..144,300..700;1,9..144,400..600&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    {{ 'theme.css' | asset_url | stylesheet_tag }}
    <style>
      .password-wrap{min-height:100vh;display:grid;place-items:center;text-align:center;
        background:radial-gradient(65% 85% at 84% 12%, rgba(228,197,108,.22), transparent 55%),radial-gradient(85% 100% at 8% 100%, rgba(122,87,192,.38), transparent 60%),linear-gradient(150deg,#2a184c 0%,#3a2568 46%,#FFFFFF 100%);padding:2rem}
      .password-card{max-width:460px}
      .password-card .brand__mark{width:64px;height:64px;color:var(--gold-bright);margin:0 auto 1.2rem}
      .password-card h1{color:#fdfbf3;font-size:clamp(2rem,5vw,3rem);margin-bottom:.8rem}
      .password-card p{color:rgba(247,242,231,.85);font-size:1.1rem;margin-bottom:1.6rem}
      .password-card form{display:flex;gap:.5rem;justify-content:center;flex-wrap:wrap}
      .password-card input[type=password]{font-family:var(--ui);padding:.85rem 1.1rem;border-radius:var(--radius-sm);border:1.5px solid rgba(228,197,108,.5);background:rgba(251,247,236,.1);color:#fbf7ec;min-width:220px}
      .password-card .errors{margin:0 auto 1rem;max-width:360px}
    </style>
  </head>
  <body>
    <div class="password-wrap">
      <div class="password-card">
        {% render 'emblem', class: 'brand__mark' %}
        {{ content_for_layout }}
        <p style="margin-top:2rem;font-family:var(--ui);font-size:.8rem;letter-spacing:.2em;text-transform:uppercase;color:rgba(244,236,216,.55)">Powered by {{ shop.name }}</p>
      </div>
    </div>
    <script src="{{ 'theme.js' | asset_url }}" defer></script>
  </body>
</html>
