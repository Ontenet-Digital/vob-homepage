        },
        "p2": {
          "type": "panel",
          "settings": {
            "eyebrow": "Our Vision",
            "heading": "A message that resonates",
            "text": "We envision a world where the Bible’s message resonates with hearts and minds — transforming lives and inspiring hope. Every scene we animate, every passage we narrate, is made to help that message land gently on a child at bedtime and just as fully on a grandparent in a quiet chair.",
            "drop_cap": false,
            "image_url": "https://visionofthebiblestore.com/cdn/shop/files/DSC04805-2-_2.jpg?v=1785302144&width=1300",
            "image_alt": "A Kids Bible Stories tablet open like a book, showing an animated scene"
          }
        },
        "p3": {
          "type": "panel",
          "settings": {
            "eyebrow": "What we bring to life",
            "heading": "Seen, heard, and remembered",
            "text": "From the miracles and parables of Jesus to the courage of the disciples and the beauty of the Holy Land, we turn Scripture into something children can see and everyone can feel. Captivating visuals, gentle narration, easy-to-follow words — the Bible, experienced rather than merely read.",
            "drop_cap": false,
            "image_url": "https://visionofthebiblestore.com/cdn/shop/files/all.png?v=1732481756&width=1400",
            "image_alt": "The full range of Vision of the Bible tablets and books"
          }
        }
      },
