<div class="page-shell page-shell--narrow wrap">
  <div class="page-head">
    <span class="eyebrow">Account</span>
    <h1>Your addresses</h1>
    <p class="form-note"><a href="{{ routes.account_url }}" style="color:var(--violet-deep);font-weight:700">&larr; Back to account</a></p>
  </div>

  <h2 style="font-family:var(--display);margin:1rem 0">Add a new address</h2>
  {%- form 'customer_address', customer.new_address, class: 'auth-form' -%}
    <input type="text" name="address[first_name]" placeholder="First name" value="{{ form.first_name }}">
    <input type="text" name="address[last_name]" placeholder="Last name" value="{{ form.last_name }}">
    <input type="text" name="address[address1]" placeholder="Address" value="{{ form.address1 }}">
    <input type="text" name="address[city]" placeholder="City" value="{{ form.city }}">
    <input type="text" name="address[zip]" placeholder="Postal / ZIP code" value="{{ form.zip }}">
    <input type="text" name="address[country]" placeholder="Country" value="{{ form.country }}">
    <button type="submit" class="btn btn--primary">Add address</button>
  {%- endform -%}

  {%- if customer.addresses.size > 0 -%}
    <h2 style="font-family:var(--display);margin:2.4rem 0 1rem">Saved addresses</h2>
    {%- for address in customer.addresses -%}
      <div style="border:1px solid var(--parchment-line);border-radius:var(--radius-md);padding:1.2rem;margin-bottom:1rem">
        <div class="rte">{{ address | format_address }}</div>
        <p class="form-note" style="margin-top:.6rem">
          <a href="{{ address.url }}" data-form-id="{{ address.id }}" style="color:var(--violet-deep);font-weight:700">Edit</a> &middot;
          <a href="{{ address.url }}" data-target="delete" data-confirm-message="Are you sure?" style="color:#8a2b2b;font-weight:700">Delete</a>
        </p>
      </div>
    {%- endfor -%}
  {%- endif -%}
</div>
