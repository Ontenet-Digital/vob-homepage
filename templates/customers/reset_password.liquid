<div class="page-shell page-shell--narrow wrap">
  <div class="page-head" style="text-align:center">
    <span class="eyebrow eyebrow-center">Reset password</span>
    <h1>Choose a new password</h1>
  </div>

  {%- form 'reset_customer_password', class: 'auth-form' -%}
    {%- if form.errors -%}
      <div class="errors">{{ form.errors | default_errors }}</div>
    {%- endif -%}
    <input type="password" name="customer[password]" placeholder="New password" autocomplete="new-password" required>
    <input
      type="password"
      name="customer[password_confirmation]"
      placeholder="Confirm password"
      autocomplete="new-password"
      required
    >
    <button type="submit" class="btn btn--primary">Reset password</button>
  {%- endform -%}
</div>
