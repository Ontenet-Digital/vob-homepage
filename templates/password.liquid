<h1>{{ shop.name }}</h1>
<p>{{ page_description | default: 'Sacred stories, brought to life. We are opening soon.' }}</p>

{%- form 'storefront_password' -%}
  {%- if form.errors -%}
    <div class="errors">{{ form.errors.translated_fields.password | capitalize }} {{ form.errors.messages.password }}</div>
  {%- endif -%}
  <input type="password" name="password" placeholder="Enter password" aria-label="Password">
  <button type="submit" class="btn btn--gold">Enter</button>
{%- endform -%}
