{%- comment -%}
  Best seller product card.
  Params: product (Product), settings (section.settings map from sections/best-seller.liquid)
{%- endcomment -%}
{%- liquid
  assign s = settings
  assign rating = product.metafields.reviews.rating.value.rating
  assign alt_image = product.media[1]
  assign has_alt_image = false
  if alt_image
    assign has_alt_image = true
  endif
  assign multi_variant = false
  unless product.has_only_default_variant
    assign multi_variant = true
  endunless
-%}
<div class="bs-card reveal">
  <div class="bs-card__media">
    <a href="{{ product.url }}" class="bs-card__media-link" aria-label="{{ product.title | escape }}" tabindex="-1">
      {%- if product.featured_image -%}
        <img
          class="bs-card__img bs-card__img--primary"
          src="{{ product.featured_image | image_url: width: 700 }}"
          srcset="{{ product.featured_image | image_url: width: 400 }} 400w, {{ product.featured_image | image_url: width: 700 }} 700w, {{ product.featured_image | image_url: width: 1000 }} 1000w"
          sizes="(max-width: 749px) 46vw, 320px"
          alt="{{ product.featured_image.alt | default: product.title | escape }}"
          width="{{ product.featured_image.width }}"
          height="{{ product.featured_image.height }}"
          loading="lazy">
      {%- else -%}
        <div class="bs-card__img bs-card__img--placeholder" aria-hidden="true"></div>
      {%- endif -%}
      {%- if has_alt_image -%}
        <img
          class="bs-card__img bs-card__img--alt"
          src="{{ alt_image | image_url: width: 700 }}"
          alt=""
          width="{{ alt_image.width }}"
          height="{{ alt_image.height }}"
          loading="lazy"
          aria-hidden="true">
      {%- endif -%}
    </a>

    {%- if product.available == false -%}
      <span class="bs-card__badge bs-card__badge--sold-out">{{ 'products.product.sold_out' | t }}</span>
    {%- elsif rating != blank and s.show_rating -%}
      <span class="bs-card__badge bs-card__badge--rating">
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2.5l2.97 6.31 6.78.82-5 4.78 1.36 6.84L12 17.9l-6.11 3.35 1.36-6.84-5-4.78 6.78-.82L12 2.5z"/></svg>
        {{ rating }}
      </span>
    {%- endif -%}

    {%- if s.show_quick_view -%}
      <a href="{{ product.url }}" class="bs-card__quickview" aria-label="Quick view — {{ product.title | escape }}">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
          <path d="M1.4 12S5 5.2 12 5.2 22.6 12 22.6 12 19 18.8 12 18.8 1.4 12 1.4 12z"/>
          <circle cx="12" cy="12" r="3"/>
        </svg>
      </a>
    {%- endif -%}

    {%- if has_alt_image and s.show_image_dots -%}
      <span class="bs-card__dots" aria-hidden="true">
        {%- for media in product.media limit: 5 -%}
          <span class="bs-card__dot{% if forloop.first %} is-active{% endif %}"></span>
        {%- endfor -%}
      </span>
    {%- endif -%}

    {%- if s.quick_add_style != 'none' -%}
      <div class="bs-card__cta">
        {%- if multi_variant -%}
          <a href="{{ product.url }}" class="bs-card__cta-btn">Select options</a>
        {%- elsif product.available == false -%}
          <a href="{{ product.url }}" class="bs-card__cta-btn bs-card__cta-btn--disabled">{{ 'products.product.sold_out' | t }}</a>
        {%- else -%}
          {%- form 'product', product, class: 'bs-card__form' -%}
            <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
            <button type="submit" class="bs-card__cta-btn">{{ 'products.product.add_to_cart' | t }}</button>
          {%- endform -%}
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>

  <div class="bs-card__body">
    {%- if s.show_vendor and product.vendor != blank -%}
      <span class="bs-card__vendor">{{ product.vendor }}</span>
    {%- endif -%}
    <h3 class="bs-card__title"><a href="{{ product.url }}">{{ product.title }}</a></h3>
    <span class="bs-card__price">
      {%- if product.compare_at_price > product.price -%}
        <s class="bs-card__price-compare">{{ product.compare_at_price | money }}</s>
      {%- endif -%}
      <span class="bs-card__price-current">{{ product.price | money }}</span>
    </span>
  </div>
</div>
