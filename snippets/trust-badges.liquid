{%- comment -%}
  Reusable trust / social-proof row.
  Usage:
    {% render 'trust-badges', section: section, class: 'hero__trust' %}
  Expects section.settings:
    trust_enable, trust_label, trust_label_color, trust_text_color, trust_star_color
  And blocks of type "trust_badge":
    label, link, icon, icon_url, icon_preset, show_stars, star_count, rating_text
{%- endcomment -%}
{%- liquid
  assign ts = section.settings
  assign trust_blocks = section.blocks | where: 'type', 'trust_badge'
-%}
{%- if ts.trust_enable -%}
  {%- if trust_blocks.size > 0 or ts.trust_label != blank -%}
    <div
      class="trust{% if class != blank %} {{ class }}{% endif %}"
      style="
        {% if ts.trust_label_color != blank %}--trust-label-color: {{ ts.trust_label_color }};{% endif %}
        {% if ts.trust_text_color != blank %}--trust-text-color: {{ ts.trust_text_color }};{% endif %}
        {% if ts.trust_star_color != blank %}--trust-star-color: {{ ts.trust_star_color }};{% endif %}
      "
    >
      {%- if ts.trust_label != blank -%}
        <p class="trust__label">{{ ts.trust_label | escape }}</p>
      {%- endif -%}

      {%- if trust_blocks.size > 0 -%}
        <ul class="trust__list" role="list">
          {%- for block in trust_blocks -%}
            {%- liquid
              assign b = block.settings
              assign icon_src = blank
              if b.icon != blank
                assign icon_src = b.icon | image_url: width: 80
              elsif b.icon_url != blank
                assign icon_src = b.icon_url
              endif
              assign tag = 'div'
              if b.link != blank
                assign tag = 'a'
              endif
            -%}
            <li class="trust__item" {{ block.shopify_attributes }}>
              <{{ tag }}
                class="trust__link"
                {% if b.link != blank %}href="{{ b.link }}" target="_blank" rel="noopener noreferrer"{% endif %}
              >
                {%- if b.show_stars -%}
                  <span class="trust__stars" aria-hidden="true">
                    {%- for i in (1..5) -%}
                      <svg class="trust__star{% if i > b.star_count %} trust__star--empty{% endif %}" viewBox="0 0 20 20" width="16" height="16" focusable="false">
                        <path fill="currentColor" d="M10 1.5l2.47 5.01 5.53.8-4 3.9.94 5.52L10 14.27l-4.94 2.46.94-5.52-4-3.9 5.53-.8L10 1.5z"/>
                      </svg>
                    {%- endfor -%}
                  </span>
                {%- elsif icon_src != blank -%}
                  <img class="trust__icon" src="{{ icon_src }}" alt="" width="20" height="20" loading="lazy">
                {%- else -%}
                  {%- case b.icon_preset -%}
                    {%- when 'trustpilot' -%}
                      <svg class="trust__icon trust__icon--trustpilot" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false">
                        <path fill="#00B67A" d="M12 1.6l2.7 8.3H24l-6.9 5 2.6 8.1L12 18l-7.7 5 2.6-8.1L0 9.9h9.3L12 1.6z"/>
                      </svg>
                    {%- when 'google' -%}
                      <svg class="trust__icon trust__icon--google" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false">
                        <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
                        <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
                        <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/>
                        <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
                      </svg>
                    {%- when 'star' -%}
                      <svg class="trust__icon" viewBox="0 0 20 20" width="18" height="18" aria-hidden="true" focusable="false">
                        <path fill="var(--trust-star-color, #F5B400)" d="M10 1.5l2.47 5.01 5.53.8-4 3.9.94 5.52L10 14.27l-4.94 2.46.94-5.52-4-3.9 5.53-.8L10 1.5z"/>
                      </svg>
                  {%- endcase -%}
                {%- endif -%}

                {%- if b.rating_text != blank -%}
                  <span class="trust__rating">{{ b.rating_text | escape }}</span>
                {%- elsif b.label != blank -%}
                  <span class="trust__name">{{ b.label | escape }}</span>
                {%- endif -%}
              </{{ tag }}>
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  {%- endif -%}
{%- endif -%}
