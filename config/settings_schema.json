[
    {
        "name": "theme_info",
        "theme_name": "Vision of the Bible",
        "theme_author": "Vision of the Bible",
        "theme_version": "1.0.0",
        "theme_documentation_url": "https://visionofthebiblestore.com",
        "theme_support_url": "https://visionofthebiblestore.com"
    },
    {
        "name": "Brand",
        "settings": [
            {
                "type": "image_picker",
                "id": "favicon",
                "label": "Favicon"
            },
            {
                "type": "image_picker",
                "id": "logo_light",
                "label": "Logo (light, for dark header)",
                "info": "Optional. Shown in the header over the dark hero. If empty, the wordmark is used."
            },
            {
                "type": "image_picker",
                "id": "logo_footer",
                "label": "Footer logo",
                "info": "Optional. If empty, a fallback wordmark is shown."
            }
        ]
    },
    {
        "name": "Colors",
        "settings": [
            {
                "type": "color",
                "id": "color_parchment",
                "label": "Parchment (page background)",
                "default": "#FFFFFF"
            },
            {
                "type": "color",
                "id": "color_ink",
                "label": "Ink (headings)",
                "default": "#251D3A"
            },
            {
                "type": "color",
                "id": "color_ink_soft",
                "label": "Ink soft (body text)",
                "default": "#463C68"
            },
            {
                "type": "color",
                "id": "color_violet_deep",
                "label": "Violet deep",
                "default": "#412773"
            },
            {
                "type": "color",
                "id": "color_violet",
                "label": "Violet",
                "default": "#7A57C0"
            },
            {
                "type": "color",
                "id": "color_gold",
                "label": "Gold",
                "default": "#BE9743"
            },
            {
                "type": "color",
                "id": "color_gold_bright",
                "label": "Gold bright",
                "default": "#E4C56C"
            },
            {
                "type": "color",
                "id": "color_gold_deep",
                "label": "Gold deep",
                "default": "#7C5D1E"
            }
        ]
    },
    {
        "name": "Layout & breakpoints",
        "settings": [
            {
                "type": "header",
                "content": "Container widths",
                "info": "Each desktop resolution tier's content container max-width. Tablet (≥768px) and Mobile (<768px) stay fluid and only use the gutters below."
            },
            {
                "type": "range",
                "id": "layout_wrap_2k",
                "label": "2K — container (≥2560px viewport)",
                "default": 1920,
                "min": 1200,
                "max": 2560,
                "step": 20,
                "unit": "px"
            },
            {
                "type": "range",
                "id": "layout_wrap_fhd",
                "label": "FHD — container (≥1920px viewport)",
                "default": 1440,
                "min": 1000,
                "max": 1920,
                "step": 10,
                "unit": "px"
            },
            {
                "type": "range",
                "id": "layout_wrap_qhd",
                "label": "QHD — container (≥1440px viewport)",
                "default": 1280,
                "min": 900,
                "max": 1440,
                "step": 10,
                "unit": "px"
            },
            {
                "type": "range",
                "id": "layout_wrap_hdplus",
                "label": "HD+ — container (≥1280px viewport)",
                "default": 1024,
                "min": 800,
                "max": 1280,
                "step": 8,
                "unit": "px"
            },
            {
                "type": "range",
                "id": "layout_wrap_hd",
                "label": "HD — container (≥1024px viewport)",
                "default": 768,
                "min": 600,
                "max": 1024,
                "step": 8,
                "unit": "px"
            },
            {
                "type": "header",
                "content": "Gutters (fluid tiers)"
            },
            {
                "type": "range",
                "id": "layout_gutter_tab",
                "label": "Tablet gutter (≥768px)",
                "default": 24,
                "min": 8,
                "max": 64,
                "step": 2,
                "unit": "px"
            },
            {
                "type": "range",
                "id": "layout_gutter_mobile",
                "label": "Mobile gutter (<768px)",
                "default": 16,
                "min": 8,
                "max": 64,
                "step": 2,
                "unit": "px"
            }
        ]
    },
    {
        "name": "Social media",
        "settings": [
            { "type": "url", "id": "social_facebook", "label": "Facebook URL" },
            {
                "type": "url",
                "id": "social_instagram",
                "label": "Instagram URL"
            },
            { "type": "url", "id": "social_youtube", "label": "YouTube URL" },
            { "type": "url", "id": "social_tiktok", "label": "TikTok URL" }
        ]
    },
    {
        "name": "Cart & free shipping",
        "settings": [
            {
                "type": "checkbox",
                "id": "free_shipping_enabled",
                "label": "Enable free shipping progress bar",
                "default": true
            },
            {
                "type": "number",
                "id": "free_shipping_threshold",
                "label": "Free shipping threshold (currency)",
                "default": 140,
                "info": "The progress bar fills toward this amount; free shipping unlocks when the cart total reaches it."
            }
        ]
    }
]
