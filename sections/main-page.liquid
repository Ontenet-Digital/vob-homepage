<div class="page-shell page-shell--narrow wrap">
  <div class="page-head">
    <span class="eyebrow eyebrow-left">Vision of the Bible stories</span>
    <h1>{{ page.title }}</h1>
  </div>
  <div class="rte">{{ page.content }}</div>

  {%- comment -%}
    Render app blocks (e.g. contact / form builder apps like Glood, Hulk,
    Vitals, etc.) that are added to this section in the theme editor.
    Without this loop, app blocks are never output and forms silently disappear.
  {%- endcomment -%}
  {%- for block in section.blocks -%}
    {%- case block.type -%}
      {%- when '@app' -%}
        {%- render block -%}
    {%- endcase -%}
  {%- endfor -%}
</div>

{% schema %}
{
  "name": "Page",
  "settings": [],
  "blocks": [
    {
      "type": "@app"
    }
  ],
  "max_blocks": 1
}
{% endschema %}
