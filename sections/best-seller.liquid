{%- liquid
  assign s = section.settings
  assign blocks = section.blocks
  assign tab_count = blocks.size
  assign show_tabs = s.show_tabs
  if tab_count < 2
    assign show_tabs = false
  endif

  # Defensive defaults: guarantees valid CSS values even if a setting was
  # ever saved blank (e.g. while the schema briefly had a validation error).
  # An invalid value fed into grid-template-columns/aspect-ratio doesn't
  # fall back gracefully — it invalidates the whole declaration, which is
  # what collapses the grid to a single full-width column.
  assign cols_desktop = s.columns_desktop | default: 4
  assign cols_tablet = s.columns_tablet | default: 1
  assign cols_mobile = s.columns_mobile | default: 1
  assign gap_desktop = s.grid_gap | default: 24
  assign gap_mobile = s.grid_gap_mobile | default: 14
  assign pad_top = s.padding_top | default: 72
  assign pad_bottom = s.padding_bottom | default: 72
  assign card_radius = s.card_radius | default: 10
  assign tab_radius = s.tab_radius | default: 30
  assign cta_radius = s.quick_add_radius | default: 30
  assign title_size = s.title_size | default: 16
  assign img_ratio = s.image_ratio | default: '1/1'
  if cols_desktop == blank or cols_desktop < 2
    assign cols_desktop = 4
  endif
  if cols_tablet == blank or cols_tablet < 1
    assign cols_tablet = 1
  endif
  # "Columns — mobile" and "Columns — tablet" are set to 1: a single
  # full-width card per row on mobile + tablet (per design direction).
  if cols_mobile == blank or cols_mobile < 1
    assign cols_mobile = 1
  endif
-%}

{% style %}
  #shopify-section-{{ section.id }} .bs{
    --bs-bg: {{ s.bg_color | default: '#ffffff' }};
    --bs-pad-t: {{ pad_top }}px;
    --bs-pad-b: {{ pad_bottom }}px;
    --bs-cols: {{ cols_desktop }};
    --bs-gap-x: {{ gap_desktop }}px;
    --bs-gap-y: {{ gap_desktop }}px;
    --bs-card-bg: {{ s.card_bg | default: '#ffffff' }};
    --bs-card-border: {{ s.card_border_color | default: '#ede6d6' }};
    --bs-card-radius: {{ card_radius }}px;
    --bs-img-ratio: {{ img_ratio }};
    --bs-vendor-color: {{ s.vendor_color | default: '#be9743' }};
    --bs-title-color: {{ s.title_color | default: '#251d3a' }};
    --bs-title-size: {{ title_size }}px;
    --bs-price-color: {{ s.price_color | default: '#251d3a' }};
    --bs-compare-color: {{ s.compare_price_color | default: '#8b8398' }};
    --bs-rating-color: {{ s.rating_text_color | default: '#be9743' }};
    --bs-quickview-color: {{ s.quickview_icon_color | default: '#251d3a' }};
    --bs-cta-bg: {{ s.quick_add_bg_color | default: '#251d3a' }};
    --bs-cta-color: {{ s.quick_add_text_color | default: '#fdfbf3' }};
    --bs-cta-radius: {{ cta_radius }}px;
    --bs-dot-active: {{ s.dot_active_color | default: '#be9743' }};
    --bs-tab-active-bg: {{ s.tab_active_bg | default: '#251d3a' }};
    --bs-tab-active-color: {{ s.tab_active_text | default: '#fdfbf3' }};
    --bs-tab-inactive-bg: {{ s.tab_inactive_bg | default: '#ffffff' }};
    --bs-tab-inactive-color: {{ s.tab_inactive_text | default: '#251d3a' }};
    --bs-tab-border: {{ s.card_border_color | default: '#ede6d6' }};
    --bs-tab-radius: {{ tab_radius }}px;
  }

  @media (max-width: 989px){
    #shopify-section-{{ section.id }} .bs{
      --bs-cols: {{ cols_tablet }};
    }
  }

  @media (max-width: 749px){
    #shopify-section-{{ section.id }} .bs{
      --bs-pad-t: {{ pad_top | times: 0.65 | round }}px;
      --bs-pad-b: {{ pad_bottom | times: 0.65 | round }}px;
      --bs-cols: {{ cols_mobile }};
      --bs-gap-x: {{ gap_mobile }}px;
      --bs-gap-y: {{ gap_mobile }}px;
      --bs-title-size: {{ title_size | times: 0.9 | round }}px;
    }
  }

  {%- for block in blocks -%}
    {%- assign i = forloop.index -%}
    #shopify-section-{{ section.id }} #bs-tab-{{ section.id }}-{{ i }}:checked ~ .bs__tabs .bs__tab-btn[data-tab="{{ i }}"]{
      background: var(--bs-tab-active-bg);
      color: var(--bs-tab-active-color);
      border-color: var(--bs-tab-active-bg);
    }
    #shopify-section-{{ section.id }} #bs-tab-{{ section.id }}-{{ i }}:checked ~ .bs__panels .bs__panel[data-panel="{{ i }}"]{
      display: block;
    }
  {%- endfor -%}
{% endstyle %}

<section class="bs wrap" id="{{ s.anchor_id | default: 'best-sellers' }}" data-quick-add="{{ s.quick_add_style }}">
  {%- if s.eyebrow != blank or s.heading != blank or s.subheading != blank -%}
    <div class="bs__head bs__head--{{ s.heading_align }} reveal">
      {%- if s.eyebrow != blank -%}<span class="eyebrow{% if s.heading_align == 'center' %} center{% endif %}">{{ s.eyebrow }}</span>{%- endif -%}
      {%- if s.heading != blank -%}<h2>{{ s.heading }}</h2>{%- endif -%}
      {%- if s.subheading != blank -%}<p>{{ s.subheading }}</p>{%- endif -%}
    </div>
  {%- endif -%}

  {%- if tab_count > 0 -%}
    {%- if show_tabs -%}
      {%- for block in blocks -%}
        <input type="radio" class="bs__radio" name="bs-tabs-{{ section.id }}" id="bs-tab-{{ section.id }}-{{ forloop.index }}"{% if forloop.first %} checked{% endif %}>
      {%- endfor -%}

      <div class="bs__tabs bs__tabs--{{ s.heading_align }} reveal" role="tablist">
        {%- for block in blocks -%}
          <label class="bs__tab-btn" data-tab="{{ forloop.index }}" for="bs-tab-{{ section.id }}-{{ forloop.index }}" {{ block.shopify_attributes }}>{{ block.settings.label }}</label>
        {%- endfor -%}
      </div>
    {%- endif -%}

    <div class="bs__panels">
      {%- for block in blocks -%}
        {%- unless show_tabs or forloop.first -%}{%- continue -%}{%- endunless -%}
        {%- liquid
          assign coll = block.settings.collection
          # Only force-show panel 1 when tabs are off (it's the sole panel
          # in the DOM then). With tabs on, visibility must come only from
          # the radio ":checked" rules below — otherwise panel 1 never
          # hides and stacks on top of whichever tab you click into.
          assign force_visible = false
          if forloop.first and show_tabs == false
            assign force_visible = true
          endif
        -%}
        <div class="bs__panel{% if force_visible %} bs__panel--first{% endif %}" data-panel="{{ forloop.index }}" {{ block.shopify_attributes }}>
          {%- if coll != blank and coll.products.size > 0 -%}
            <div class="bs__grid">
              {%- for product in coll.products limit: block.settings.products_to_show -%}
                {%- render 'product-card', product: product, settings: s -%}
              {%- endfor -%}
            </div>
            {%- if s.show_view_all -%}
              <div class="bs__viewall">
                <a class="btn btn--ghost bs__viewall-btn" href="{{ coll.url }}">View all</a>
              </div>
            {%- endif -%}
          {%- else -%}
            <div class="bs__empty">
              <p>Select a collection for the “{{ block.settings.label | default: 'Best sellers' }}” tab in the theme editor to show products here.</p>
            </div>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  {%- else -%}
    <div class="bs__empty">
      <p>Add a tab block and choose a collection to show best sellers.</p>
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Best sellers",
  "tag": "section",
  "settings": [
    { "type": "header", "content": "Heading" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Loved by families" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Best Sellers" },
    { "type": "textarea", "id": "subheading", "label": "Subheading" },
    {
      "type": "select", "id": "heading_align", "label": "Heading alignment", "default": "left",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ]
    },

    { "type": "header", "content": "Tabs" },
    { "type": "checkbox", "id": "show_tabs", "label": "Show tabs", "default": true, "info": "Needs at least 2 tab blocks. With one tab, its products show without a tab bar. Tabs share the heading's alignment." },
    { "type": "color", "id": "tab_active_bg", "label": "Active tab background", "default": "#251D3A" },
    { "type": "color", "id": "tab_active_text", "label": "Active tab text", "default": "#FDFBF3" },
    { "type": "color", "id": "tab_inactive_bg", "label": "Inactive tab background", "default": "#FFFFFF" },
    { "type": "color", "id": "tab_inactive_text", "label": "Inactive tab text", "default": "#251D3A" },
    { "type": "range", "id": "tab_radius", "label": "Tab corner radius", "min": 0, "max": 40, "step": 1, "unit": "px", "default": 30 },

    { "type": "header", "content": "Grid" },
    { "type": "range", "id": "columns_desktop", "label": "Columns — desktop", "min": 2, "max": 5, "step": 1, "default": 4 },
    { "type": "range", "id": "columns_tablet", "label": "Columns — tablet", "min": 1, "max": 4, "step": 1, "default": 1 },
    { "type": "range", "id": "columns_mobile", "label": "Columns — mobile", "min": 1, "max": 4, "step": 1, "default": 1 },
    { "type": "range", "id": "grid_gap", "label": "Grid gap — desktop", "min": 8, "max": 48, "step": 2, "unit": "px", "default": 24 },
    { "type": "range", "id": "grid_gap_mobile", "label": "Grid gap — mobile", "min": 4, "max": 32, "step": 2, "unit": "px", "default": 14 },

    { "type": "header", "content": "Card" },
    { "type": "color", "id": "card_bg", "label": "Card background", "default": "#FFFFFF" },
    { "type": "color", "id": "card_border_color", "label": "Card border", "default": "#EDE6D6" },
    { "type": "range", "id": "card_radius", "label": "Card corner radius", "min": 0, "max": 32, "step": 1, "unit": "px", "default": 10 },
    {
      "type": "select", "id": "image_ratio", "label": "Image ratio", "default": "1/1",
      "options": [
        { "value": "1/1", "label": "Square" },
        { "value": "4/5", "label": "Portrait (4:5)" },
        { "value": "3/4", "label": "Portrait (3:4)" },
        { "value": "5/4", "label": "Landscape (5:4)" },
        { "value": "4/3", "label": "Landscape (4:3)" }
      ]
    },

    { "type": "header", "content": "Product info" },
    { "type": "checkbox", "id": "show_vendor", "label": "Show vendor", "default": true },
    { "type": "color", "id": "vendor_color", "label": "Vendor colour", "default": "#BE9743" },
    { "type": "color", "id": "title_color", "label": "Title colour", "default": "#251D3A" },
    { "type": "range", "id": "title_size", "label": "Title size — desktop", "min": 13, "max": 24, "step": 1, "unit": "px", "default": 16 },
    { "type": "color", "id": "price_color", "label": "Price colour", "default": "#251D3A" },
    { "type": "color", "id": "compare_price_color", "label": "Compare-at price colour", "default": "#8B8398" },

    { "type": "header", "content": "Rating badge", "info": "Shown automatically when a product has a review rating (e.g. via a reviews app)." },
    { "type": "checkbox", "id": "show_rating", "label": "Show rating badge", "default": true },
    { "type": "color", "id": "rating_text_color", "label": "Badge text & star colour", "default": "#BE9743" },

    { "type": "header", "content": "Quick view" },
    { "type": "checkbox", "id": "show_quick_view", "label": "Show quick view icon", "default": true },
    { "type": "color", "id": "quickview_icon_color", "label": "Icon colour", "default": "#251D3A" },

    { "type": "header", "content": "Quick add" },
    {
      "type": "select", "id": "quick_add_style", "label": "Add to cart button", "default": "hover",
      "options": [
        { "value": "hover", "label": "Show on hover (always on touch devices)" },
        { "value": "always", "label": "Always visible" },
        { "value": "none", "label": "Hidden" }
      ]
    },
    { "type": "color", "id": "quick_add_bg_color", "label": "Button background", "default": "#251D3A" },
    { "type": "color", "id": "quick_add_text_color", "label": "Button text", "default": "#FDFBF3" },
    { "type": "range", "id": "quick_add_radius", "label": "Button corner radius", "min": 0, "max": 40, "step": 1, "unit": "px", "default": 30 },

    { "type": "header", "content": "Image dots", "info": "A decorative indicator shown when a product has more than one image." },
    { "type": "checkbox", "id": "show_image_dots", "label": "Show image dots", "default": true },
    { "type": "color", "id": "dot_active_color", "label": "Active dot colour", "default": "#BE9743" },

    { "type": "header", "content": "View all button" },
    { "type": "checkbox", "id": "show_view_all", "label": "Show view all button", "default": false },

    { "type": "header", "content": "Section" },
    { "type": "color", "id": "bg_color", "label": "Background colour", "default": "#FFFFFF" },
    { "type": "range", "id": "padding_top", "label": "Top padding — desktop", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 72 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding — desktop", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 72 },
    { "type": "text", "id": "anchor_id", "label": "Anchor id", "default": "best-sellers" }
  ],
  "blocks": [
    {
      "type": "tab",
      "name": "Tab",
      "settings": [
        { "type": "text", "id": "label", "label": "Tab label", "default": "Tablets", "info": "The text shown on the pill button, e.g. \"Tablets\" or \"Coffee Table Book\"." },
        { "type": "collection", "id": "collection", "label": "Collection", "info": "Give each tab its own collection — if two tabs share one collection, they'll show the same products and look identical when you switch between them." },
        { "type": "range", "id": "products_to_show", "label": "Products to show", "min": 2, "max": 12, "step": 1, "default": 8 }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Best sellers",
      "blocks": [
        { "type": "tab", "settings": { "label": "Tablets" } },
        { "type": "tab", "settings": { "label": "Coffee Table Book" } }
      ]
    }
  ]
}
{% endschema %}
