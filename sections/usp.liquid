<section class="usp wrap" id="{{ section.settings.anchor_id | default: 'usp' }}">
  <div class="sec-head reveal">
    {%- if section.settings.eyebrow != blank -%}
      <span class="eyebrow eyebrow-center">{{ section.settings.eyebrow }}</span>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h2>{{ section.settings.heading }}</h2>
    {%- endif -%}
    {%- if section.settings.subheading != blank -%}
      <p>{{ section.settings.subheading }}</p>
    {%- endif -%}
  </div>

  <div class="usp__grid">
    {%- for block in section.blocks -%}
      {%- liquid
        assign icon_src = blank
        if block.settings.image != blank
          assign icon_src = block.settings.image | image_url: width: 240
        elsif block.settings.image_url != blank
          assign icon_src = block.settings.image_url
        endif
      -%}
      <div class="usp__item reveal" {{ block.shopify_attributes }}>
        {%- if icon_src != blank -%}
          <span class="usp__icon-wrap">
            <img
              class="usp__icon"
              src="{{ icon_src }}"
              alt=""
              width="120"
              height="120"
              loading="lazy"
            >
          </span>
        {%- endif -%}
        {%- if block.settings.label != blank -%}
          <p class="usp__label">{{ block.settings.label }}</p>
        {%- endif -%}
      </div>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "USP",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Why families choose us" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Built for peace of mind" },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Simple promises that travel with every order."
    },
    { "type": "text", "id": "anchor_id", "label": "Anchor id", "default": "usp" }
  ],
  "blocks": [
    {
      "type": "usp",
      "name": "USP",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Icon image" },
        { "type": "text", "id": "image_url", "label": "Fallback icon URL" },
        { "type": "text", "id": "label", "label": "Label", "default": "Christian Values" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "USP",
      "blocks": [
        { "type": "usp", "settings": { "label": "Christian Values" } },
        { "type": "usp", "settings": { "label": "Safe Screentime" } },
        { "type": "usp", "settings": { "label": "Scripture-Rooted" } },
        { "type": "usp", "settings": { "label": "Biblical Learning" } },
        { "type": "usp", "settings": { "label": "Faith-Building" } },
        { "type": "usp", "settings": { "label": "Sacred Stories" } }
      ]
    }
  ]
}
{% endschema %}
