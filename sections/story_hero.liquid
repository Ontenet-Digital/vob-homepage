{%- comment -%}
  story_hero — full-bleed hero for the Our Story page.
  Renders a kicker ("About"), headline and optional subtext over a warm
  landscape image (or a rich brown gradient). Styles in assets/story-pages.css.
{%- endcomment -%}

{%- liquid
  assign s = section.settings
  assign has_img = false
  if s.image != blank or s.image_url != blank
    assign has_img = true
  endif
-%}

<section class="story-hero" id="{{ s.anchor_id | default: 'story-hero' }}">
  {%- if has_img -%}
    <div class="story-hero__media" aria-hidden="true">
      {%- if s.image != blank -%}
        <img
          src="{{ s.image | image_url: width: 2000 }}"
          srcset="
            {{ s.image | image_url: width: 720 }} 720w,
            {{ s.image | image_url: width: 1100 }} 1100w,
            {{ s.image | image_url: width: 1600 }} 1600w,
            {{ s.image | image_url: width: 2000 }} 2000w
          "
          sizes="100vw"
          alt="{{ s.image.alt | default: s.heading | escape }}"
          fetchpriority="high"
          decoding="async"
          width="{{ s.image.width }}"
          height="{{ s.image.height }}"
        >
      {%- else -%}
        <img
          src="{{ s.image_url }}"
          alt="{{ s.heading | escape }}"
          fetchpriority="high"
          decoding="async"
          width="2000"
          height="1333"
        >
      {%- endif -%}
    </div>
    <div class="story-hero__overlay" aria-hidden="true"></div>
  {%- endif -%}

  <div class="story-hero__inner wrap">
    {%- if s.kicker != blank -%}
      <span class="story-kicker">{{ s.kicker }}</span>
    {%- endif -%}
    {%- if s.heading != blank -%}
      <h1 class="story-hero__title">{{ s.heading }}</h1>
    {%- endif -%}
    {%- if s.subtitle != blank -%}
      <p class="story-hero__sub">{{ s.subtitle }}</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "story_hero",
  "tag": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero image",
      "info": "Warm landscape works best. Falls back to a rich brown gradient when empty."
    },
    { "type": "text", "id": "image_url", "label": "Hero image URL (fallback)" },
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "About" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Vision of The Bible stories" },
    { "type": "text", "id": "subtitle", "label": "Subtext", "default": "A journey through light, imagery and faith." },
    { "type": "text", "id": "anchor_id", "label": "Anchor id", "default": "story-hero" }
  ],
  "presets": [{ "name": "story_hero" }]
}
{% endschema %}
