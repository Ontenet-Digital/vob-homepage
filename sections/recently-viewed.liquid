{%- comment -%}
  ============================================================
  Recently viewed products
  ------------------------------------------------------------
  Tracks the products a visitor looks at, entirely on their own
  device (localStorage) — no cookies, no account, no network
  calls. On every product page this section:
    1. Records the current product (url, title, image, price…)
       into a capped, most-recent-first list in localStorage.
    2. Renders a strip of the previously viewed products
       (excluding the one being viewed).
  If nothing has been viewed yet the section hides itself.
  Because the price/image are captured at view time, cards render
  instantly with correct formatting and zero extra requests.
  ============================================================
{%- endcomment -%}

{%- liquid
  assign s = section.settings
  assign cols = s.columns | default: 4
  assign cols_tablet = s.columns_tablet | default: 3
  assign cols_mobile = s.columns_mobile | default: 2
-%}

{% style %}
  #shopify-section-{{ section.id }} .rvp{
    --rv-cols: {{ cols }};
    --rv-cols-tablet: {{ cols_tablet }};
    --rv-cols-mobile: {{ cols_mobile }};
    --rv-bg: {{ s.bg_color | default: '#ffffff' }};
    --rv-pad-t: {{ s.padding_top | default: 24 }}px;
    --rv-pad-b: {{ s.padding_bottom | default: 72 }}px;
  }
  @media (max-width: 749px){
    #shopify-section-{{ section.id }} .rvp{
      --rv-pad-t: {{ s.padding_top | default: 24 | times: 0.8 | round }}px;
      --rv-pad-b: {{ s.padding_bottom | default: 72 | times: 0.7 | round }}px;
    }
  }
{% endstyle %}

<section
  class="rvp wrap"
  id="{{ s.anchor_id | default: 'recently-viewed' }}"
  data-rv
  data-rv-key="{{ s.storage_key | default: 'vob:recently-viewed:v1' }}"
  data-rv-limit="{{ s.products_limit | default: 4 }}"
  hidden>

  <div class="rvp__head rvp__head--{{ s.heading_align | default: 'left' }}">
    {%- if s.eyebrow != blank -%}<span class="eyebrow{% if s.heading_align == 'center' %} center{% endif %}">{{ s.eyebrow }}</span>{%- endif -%}
    {%- if s.heading != blank -%}<h2 class="rvp__heading">{{ s.heading }}</h2>{%- endif -%}
    {%- if s.subheading != blank -%}<p class="rvp__sub">{{ s.subheading }}</p>{%- endif -%}
  </div>

  <div class="rvp__grid" data-rv-grid role="list"></div>

  {%- comment -%} Current product snapshot, recorded on load {%- endcomment -%}
  <script type="application/json" data-rv-current>
    {
      "url": {{ product.url | json }},
      "title": {{ product.title | json }},
      "image": {{ product.featured_image | image_url: width: 600 | json }},
      "image_alt": {{ product.featured_image.alt | default: product.title | json }},
      "price": {{ product.price | money | json }},
      "compare": {% if product.compare_at_price > product.price %}{{ product.compare_at_price | money | json }}{% else %}null{% endif %},
      "vendor": {{ product.vendor | json }},
      "available": {{ product.available }}
    }
  </script>
</section>

{% stylesheet %}
.rvp{
  background: var(--rv-bg);
  padding-top: var(--rv-pad-t);
  padding-bottom: var(--rv-pad-b);
}
.rvp[hidden]{ display: none; }
.rvp__head{ margin: 0 0 2rem; }
.rvp__head--center{ text-align: center; }
.rvp__head--center .eyebrow{ justify-content: center; }
.rvp__heading{
  font-family: var(--display, "Fraunces", Georgia, serif);
  font-weight: 400; font-size: clamp(1.7rem, 3vw, 2.5rem); line-height: 1.08;
  margin: .9rem 0 0; color: var(--ink);
}
.rvp__sub{ margin: .6rem 0 0; color: var(--ink-soft); font-size: 1.06rem; }

.rvp__grid{
  display: grid;
  grid-template-columns: repeat(var(--rv-cols, 4), minmax(0, 1fr));
  gap: clamp(14px, 2vw, 22px);
}
@media (max-width: 989px){ .rvp__grid{ grid-template-columns: repeat(var(--rv-cols-tablet, 3), minmax(0, 1fr)); } }
@media (max-width: 620px){ .rvp__grid{ grid-template-columns: repeat(var(--rv-cols-mobile, 2), minmax(0, 1fr)); } }

.rvp__note{
  grid-column: 1 / -1;
  border: 1px dashed var(--parchment-line, #ccc);
  border-radius: var(--radius-md, 6px);
  padding: 2rem; text-align: center; color: var(--ink-soft);
  font-family: var(--ui, "Manrope", system-ui, sans-serif); font-size: .95rem;
}
{% endstylesheet %}

{% javascript %}
(function () {
  "use strict";

  function readJSON(el) {
    if (!el) return null;
    try { return JSON.parse(el.textContent); } catch (e) { return null; }
  }

  function storageOK() {
    try {
      var k = "__rv_test__";
      window.localStorage.setItem(k, "1");
      window.localStorage.removeItem(k);
      return true;
    } catch (e) { return false; }
  }

  function esc(str) {
    return String(str == null ? "" : str).replace(/[&<>"']/g, function (c) {
      return { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c];
    });
  }

  function cardHTML(it) {
    var media = it.image
      ? '<div class="grid-card__media"><img src="' + esc(it.image) + '" alt="' + esc(it.image_alt || it.title) + '" loading="lazy"></div>'
      : '<div class="grid-card__media"></div>';
    var price = '<span class="grid-card__price">' +
      (it.compare ? "<s>" + esc(it.compare) + "</s> " : "") +
      esc(it.price || "") + "</span>";
    return '<a class="grid-card" href="' + esc(it.url) + '" role="listitem">' +
      media +
      '<div class="grid-card__body"><h3>' + esc(it.title) + "</h3>" + price + "</div></a>";
  }

  function initSection(root) {
    if (!root || root.__rvInit) return;
    root.__rvInit = true;

    var grid = root.querySelector("[data-rv-grid]");
    var current = readJSON(root.querySelector("[data-rv-current]"));
    var key = root.getAttribute("data-rv-key") || "vob:recently-viewed:v1";
    var limit = parseInt(root.getAttribute("data-rv-limit"), 10) || 4;
    var CAP = 20;
    var designMode = !!(window.Shopify && window.Shopify.designMode);

    if (!grid) return;

    if (!storageOK()) {
      if (designMode) showNote(root, grid, "Recently viewed products appear here as visitors browse. (Storage is blocked in this preview.)");
      return;
    }

    /* ---- Load list ---- */
    var list = [];
    try { list = JSON.parse(window.localStorage.getItem(key)) || []; } catch (e) { list = []; }
    if (!Array.isArray(list)) list = [];

    /* ---- Record current product (most-recent first, deduped, capped) ---- */
    if (current && current.url) {
      list = list.filter(function (it) { return it && it.url && it.url !== current.url; });
      list.unshift(current);
      if (list.length > CAP) list = list.slice(0, CAP);
      try { window.localStorage.setItem(key, JSON.stringify(list)); } catch (e) {}
    }

    /* ---- Render (exclude the product being viewed) ---- */
    var toShow = list.filter(function (it) {
      return it && it.url && (!current || it.url !== current.url);
    }).slice(0, limit);

    if (!toShow.length) {
      if (designMode) {
        showNote(root, grid, "As visitors view products, their recently viewed items show here. Browse a few products on your live store to populate this.");
        root.hidden = false;
      }
      return;
    }

    grid.innerHTML = toShow.map(cardHTML).join("");
    root.hidden = false;
  }

  function showNote(root, grid, text) {
    grid.innerHTML = '<p class="rvp__note">' + text + "</p>";
    root.hidden = false;
  }

  function boot() { document.querySelectorAll("[data-rv]").forEach(initSection); }
  if (document.readyState !== "loading") boot();
  else document.addEventListener("DOMContentLoaded", boot);

  document.addEventListener("shopify:section:load", function (e) {
    var el = e.target.querySelector ? e.target.querySelector("[data-rv]") : null;
    if (e.target.matches && e.target.matches("[data-rv]")) el = e.target;
    if (el) { el.__rvInit = false; initSection(el); }
  });
})();
{% endjavascript %}

{% schema %}
{
  "name": "Recently viewed",
  "tag": "section",
  "class": "section-recently-viewed",
  "settings": [
    { "type": "paragraph", "content": "Shows each visitor the products they recently viewed, tracked privately in their browser. It stays hidden until there is something to show." },

    { "type": "header", "content": "Heading" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Keep exploring" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Recently viewed" },
    { "type": "textarea", "id": "subheading", "label": "Subheading" },
    {
      "type": "select", "id": "heading_align", "label": "Heading alignment", "default": "left",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ]
    },

    { "type": "header", "content": "Products" },
    { "type": "range", "id": "products_limit", "label": "Max products to show", "min": 2, "max": 12, "step": 1, "default": 4 },

    { "type": "header", "content": "Grid" },
    { "type": "range", "id": "columns", "label": "Columns — desktop", "min": 2, "max": 6, "step": 1, "default": 4 },
    { "type": "range", "id": "columns_tablet", "label": "Columns — tablet", "min": 2, "max": 4, "step": 1, "default": 3 },
    { "type": "range", "id": "columns_mobile", "label": "Columns — mobile", "min": 1, "max": 3, "step": 1, "default": 2 },

    { "type": "header", "content": "Section" },
    { "type": "color", "id": "bg_color", "label": "Background colour", "default": "#FFFFFF" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 24 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 72 },
    { "type": "text", "id": "anchor_id", "label": "Anchor id", "default": "recently-viewed" },
    { "type": "text", "id": "storage_key", "label": "Storage key", "info": "Advanced: the localStorage key used to remember viewed products.", "default": "vob:recently-viewed:v1" }
  ],
  "presets": [
    { "name": "Recently viewed" }
  ]
}
{% endschema %}
