{%- comment -%}
  ============================================================
  Recently viewed products
  ------------------------------------------------------------
  Tracks the products a visitor looks at, entirely on their own
  device (localStorage) — no cookies, no account, no network
  calls. On every product page this section:
    1. Records the current product (url, title, image, price…)
       into a capped, most-recent-first list in localStorage.
    2. Renders a strip of the previously viewed products
       (excluding the one being viewed).
  If nothing has been viewed yet the section hides itself.
  Because the price/image are captured at view time, cards render
  instantly with correct formatting and zero extra requests.
  ============================================================
{%- endcomment -%}

{%- liquid
  assign s = section.settings
  assign cols = s.columns | default: 4
  assign cols_tablet = s.columns_tablet | default: 3
  assign cols_mobile = s.columns_mobile | default: 1

  # Card behaviour flags — default on, only off when explicitly false (mirrors
  # snippets/product-card.liquid) so the JS builder respects the settings.
  assign show_vendor = true
  if s.show_vendor == false
    assign show_vendor = false
  endif
  assign show_rating = true
  if s.show_rating == false
    assign show_rating = false
  endif
  assign show_quick_view = true
  if s.show_quick_view == false
    assign show_quick_view = false
  endif
  assign show_image_dots = true
  if s.show_image_dots == false
    assign show_image_dots = false
  endif
  assign quick_add_style = s.quick_add_style | default: 'hover'
-%}

{% style %}
  #shopify-section-{{ section.id }} .rvp{
    --rv-cols: {{ cols }};
    --rv-cols-tablet: {{ cols_tablet }};
    --rv-cols-mobile: {{ cols_mobile }};
    --rv-bg: {{ s.bg_color | default: '#ffffff' }};
    --rv-pad-t: {{ s.padding_top | default: 24 }}px;
    --rv-pad-b: {{ s.padding_bottom | default: 72 }}px;
    /* Card custom properties read by the JS-built cards (styles in best-seller.css) */
    --bs-card-bg: {{ s.card_bg | default: '#ffffff' }};
    --bs-card-border: {{ s.card_border_color | default: '#ede6d6' }};
    --bs-card-radius: {{ s.card_radius | default: 10 }}px;
    --bs-img-ratio: {{ s.image_ratio | default: '1/1' }};
    --bs-vendor-color: {{ s.vendor_color | default: '#be9743' }};
    --bs-title-color: {{ s.title_color | default: '#251d3a' }};
    --bs-title-size: {{ s.title_size | default: 16 }}px;
    --bs-price-color: {{ s.price_color | default: '#251d3a' }};
    --bs-compare-color: {{ s.compare_price_color | default: '#8b8398' }};
    --bs-rating-color: {{ s.rating_text_color | default: '#be9743' }};
    --bs-quickview-color: {{ s.quickview_icon_color | default: '#251d3a' }};
    --bs-cta-bg: {{ s.quick_add_bg_color | default: '#251d3a' }};
    --bs-cta-color: {{ s.quick_add_text_color | default: '#fdfbf3' }};
    --bs-cta-radius: {{ s.quick_add_radius | default: 30 }}px;
    --bs-dot-active: {{ s.dot_active_color | default: '#be9743' }};
  }
  @media (max-width: 749px){
    #shopify-section-{{ section.id }} .rvp{
      --rv-pad-t: {{ s.padding_top | default: 24 | times: 0.8 | round }}px;
      --rv-pad-b: {{ s.padding_bottom | default: 72 | times: 0.7 | round }}px;
    }
  }
{% endstyle %}

<section
  class="rvp wrap"
  id="{{ s.anchor_id | default: 'recently-viewed' }}"
  data-rv
  data-rv-key="vob:recently-viewed:v1"
  data-rv-limit="{{ s.products_limit | default: 4 }}"
  data-rv-show-vendor="{{ show_vendor }}"
  data-rv-show-rating="{{ show_rating }}"
  data-rv-show-quickview="{{ show_quick_view }}"
  data-rv-show-dots="{{ show_image_dots }}"
  data-rv-quick-add="{{ quick_add_style }}"
  hidden
>
  <div class="rvp__head rvp__head--{{ s.heading_align | default: 'left' }}">
    {%- if s.eyebrow != blank -%}
      <span class="eyebrow{% if s.heading_align == 'center' %} center{% endif %}">{{ s.eyebrow }}</span>
    {%- endif -%}
    {%- if s.heading != blank -%}
      <h2 class="rvp__heading">{{ s.heading }}</h2>
    {%- endif -%}
    {%- if s.subheading != blank -%}
      <p class="rvp__sub">{{ s.subheading }}</p>
    {%- endif -%}
  </div>

  <div class="rvp__grid" data-rv-grid role="list"></div>

  {%- comment -%} Current product snapshot, recorded on load {%- endcomment -%}
  <script type="application/json" data-rv-current>
    {
      "url": {{ product.url | json }},
      "title": {{ product.title | json }},
      "image": {{ product.featured_image | image_url: width: 600 | json }},
      "image_alt": {{ product.featured_image.alt | default: product.title | json }},
      "image_2": {% if product.media[1] %}{{ product.media[1] | image_url: width: 600 | json }}{% else %}null{% endif %},
      "media_count": {{ product.media.size | json }},
      "rating": {{ product.metafields.reviews.rating.value.rating | json }},
      "price": {{ product.price | money | json }},
      "compare": {% if product.compare_at_price > product.price %}{{ product.compare_at_price | money | json }}{% else %}null{% endif %},
      "vendor": {{ product.vendor | json }},
      "available": {{ product.available }},
      "variant_id": {{ product.selected_or_first_available_variant.id | json }},
      "multi_variant": {% if product.has_only_default_variant %}false{% else %}true{% endif %}
    }
  </script>
</section>

{% stylesheet %}
  .rvp {
    background: var(--rv-bg);
    padding-top: var(--rv-pad-t);
    padding-bottom: var(--rv-pad-b);
  }
  .rvp[hidden] {
    display: none;
  }
  .rvp__head {
    margin: 0 0 2rem;
  }
  .rvp__head--center {
    text-align: center;
  }
  .rvp__head--center .eyebrow {
    justify-content: center;
  }
  .rvp__heading {
    font-family: var(--display, 'Fraunces', Georgia, serif);
    font-weight: 400;
    font-size: clamp(1.7rem, 3vw, 2.5rem);
    line-height: 1.08;
    margin: 0.9rem 0 0;
    color: var(--ink);
  }
  .rvp__sub {
    margin: 0.6rem 0 0;
    color: var(--ink-soft);
    font-size: 1.06rem;
  }

  .rvp__grid {
    display: grid;
    grid-template-columns: repeat(var(--rv-cols, 4), minmax(0, 1fr));
    gap: clamp(14px, 2vw, 22px);
  }
  @media (max-width: 989px) {
    .rvp__grid {
      grid-template-columns: repeat(var(--rv-cols-tablet, 3), minmax(0, 1fr));
    }
  }
  @media (max-width: 620px) {
    .rvp__grid {
      grid-template-columns: repeat(var(--rv-cols-mobile, 1), minmax(0, 1fr));
    }
  }

  .rvp__note {
    grid-column: 1 / -1;
    border: 1px dashed var(--parchment-line, #ccc);
    border-radius: var(--radius-md, 6px);
    padding: 2rem;
    text-align: center;
    color: var(--ink-soft);
    font-family: var(--ui, 'Cardo', Georgia, serif);
    font-size: 0.95rem;
  }
{% endstylesheet %}

{% javascript %}
  (function () {
    'use strict';

    function readJSON(el) {
      if (!el) return null;
      try {
        return JSON.parse(el.textContent);
      } catch (e) {
        return null;
      }
    }

    function storageOK() {
      try {
        var k = '__rv_test__';
        window.localStorage.setItem(k, '1');
        window.localStorage.removeItem(k);
        return true;
      } catch (e) {
        return false;
      }
    }

    function esc(str) {
      return String(str == null ? '' : str).replace(/[&<>"']/g, function (c) {
        return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
      });
    }

    var STAR_SVG =
      '<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2.5l2.97 6.31 6.78.82-5 4.78 1.36 6.84L12 17.9l-6.11 3.35 1.36-6.84-5-4.78 6.78-.82L12 2.5z"/></svg>';
    var EYE_SVG =
      '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M1.4 12S5 5.2 12 5.2 22.6 12 22.6 12 19 18.8 12 18.8 1.4 12 1.4 12z"/><circle cx="12" cy="12" r="3"/></svg>';

    /* Builds the same bs-card markup as snippets/product-card.liquid (styles in
     best-seller.css). cfg carries the card settings from the data-* attributes. */
    function cardHTML(it, cfg) {
      var url = esc(it.url);
      var title = esc(it.title || '');
      var altText = esc(it.image_alt || it.title || '');
      var media = it.image
        ? '<img class="bs-card__img bs-card__img--primary" src="' +
          esc(it.image) +
          '" alt="' +
          altText +
          '" loading="lazy">'
        : '<div class="bs-card__img bs-card__img--placeholder" aria-hidden="true"></div>';
      var altImg = it.image_2
        ? '<img class="bs-card__img bs-card__img--alt" src="' +
          esc(it.image_2) +
          '" alt="" loading="lazy" aria-hidden="true">'
        : '';
      var badge = '';
      if (it.available === false) {
        badge = '<span class="bs-card__badge bs-card__badge--sold-out">Sold out</span>';
      } else if (cfg.showRating && it.rating) {
        badge = '<span class="bs-card__badge bs-card__badge--rating">' + STAR_SVG + esc(it.rating) + '</span>';
      }
      var quickview = cfg.showQuickView
        ? '<a href="' + url + '" class="bs-card__quickview" aria-label="Quick view — ' + title + '">' + EYE_SVG + '</a>'
        : '';
      var dots = '';
      if (cfg.showDots && it.media_count > 1) {
        var n = Math.min(parseInt(it.media_count, 10) || 0, 5);
        var d = '';
        for (var i = 0; i < n; i++) {
          d += '<span class="bs-card__dot' + (i === 0 ? ' is-active' : '') + '"></span>';
        }
        dots = '<span class="bs-card__dots" aria-hidden="true">' + d + '</span>';
      }
      var cta = '';
      if (cfg.quickAdd !== 'none') {
        var ctaInner;
        if (it.available === false) {
          ctaInner = '<a class="bs-card__cta-btn bs-card__cta-btn--disabled" href="' + url + '">Sold out</a>';
        } else if (it.multi_variant) {
          ctaInner = '<a class="bs-card__cta-btn" href="' + url + '">Select options</a>';
        } else if (it.variant_id) {
          ctaInner =
            '<form class="bs-card__form" action="/cart/add" method="post"><input type="hidden" name="id" value="' +
            esc(it.variant_id) +
            '"><button type="submit" class="bs-card__cta-btn btn--sweep-animation">Add to cart</button></form>';
        } else {
          // Stale snapshot without variant info — fall back to the product link.
          ctaInner = '<a class="bs-card__cta-btn" href="' + url + '">View</a>';
        }
        cta = '<div class="bs-card__cta">' + ctaInner + '</div>';
      }
      var vendor = cfg.showVendor && it.vendor ? '<span class="bs-card__vendor">' + esc(it.vendor) + '</span>' : '';
      var price =
        '<span class="bs-card__price">' +
        (it.compare ? '<s class="bs-card__price-compare">' + esc(it.compare) + '</s>' : '') +
        '<span class="bs-card__price-current">' +
        esc(it.price || '') +
        '</span></span>';
      return (
        '<div class="bs-card reveal" role="listitem">' +
        '<div class="bs-card__media">' +
        '<a href="' +
        url +
        '" class="bs-card__media-link" aria-label="' +
        title +
        '" tabindex="-1">' +
        media +
        altImg +
        '</a>' +
        badge +
        quickview +
        dots +
        cta +
        '</div>' +
        '<div class="bs-card__body">' +
        vendor +
        '<h3 class="bs-card__title"><a href="' +
        url +
        '">' +
        title +
        '</a></h3>' +
        price +
        '</div>' +
        '</div>'
      );
    }

    function initSection(root) {
      if (!root || root.__rvInit) return;
      root.__rvInit = true;

      var grid = root.querySelector('[data-rv-grid]');
      var current = readJSON(root.querySelector('[data-rv-current]'));
      var key = root.getAttribute('data-rv-key') || 'vob:recently-viewed:v1';
      var limit = parseInt(root.getAttribute('data-rv-limit'), 10) || 4;
      var CAP = 20;
      var designMode = !!(window.Shopify && window.Shopify.designMode);
      var cfg = {
        showVendor: root.getAttribute('data-rv-show-vendor') !== 'false',
        showRating: root.getAttribute('data-rv-show-rating') !== 'false',
        showQuickView: root.getAttribute('data-rv-show-quickview') !== 'false',
        showDots: root.getAttribute('data-rv-show-dots') !== 'false',
        quickAdd: root.getAttribute('data-rv-quick-add') || 'hover',
      };

      if (!grid) return;

      if (!storageOK()) {
        if (designMode)
          showNote(
            root,
            grid,
            'Recently viewed products appear here as visitors browse. (Storage is blocked in this preview.)'
          );
        return;
      }

      /* ---- Load list ---- */
      var list = [];
      try {
        list = JSON.parse(window.localStorage.getItem(key)) || [];
      } catch (e) {
        list = [];
      }
      if (!Array.isArray(list)) list = [];

      /* ---- Record current product (most-recent first, deduped, capped) ---- */
      if (current && current.url) {
        list = list.filter(function (it) {
          return it && it.url && it.url !== current.url;
        });
        list.unshift(current);
        if (list.length > CAP) list = list.slice(0, CAP);
        try {
          window.localStorage.setItem(key, JSON.stringify(list));
        } catch (e) {}
      }

      /* ---- Render (exclude the product being viewed) ---- */
      var toShow = list
        .filter(function (it) {
          return it && it.url && (!current || it.url !== current.url);
        })
        .slice(0, limit);

      if (!toShow.length) {
        if (designMode) {
          showNote(
            root,
            grid,
            'As visitors view products, their recently viewed items show here. Browse a few products on your live store to populate this.'
          );
          root.hidden = false;
        }
        return;
      }

      grid.innerHTML = toShow
        .map(function (it) {
          return cardHTML(it, cfg);
        })
        .join('');
      /* Cards are injected after theme-reveal.js has already run, so reveal
       them immediately instead of leaving them stuck at opacity 0. */
      grid.querySelectorAll('.reveal').forEach(function (n) {
        n.classList.add('in');
      });
      root.hidden = false;
    }

    function showNote(root, grid, text) {
      grid.innerHTML = '<p class="rvp__note">' + text + '</p>';
      root.hidden = false;
    }

    function boot() {
      document.querySelectorAll('[data-rv]').forEach(initSection);
    }
    if (document.readyState !== 'loading') boot();
    else document.addEventListener('DOMContentLoaded', boot);

    document.addEventListener('shopify:section:load', function (e) {
      var el = e.target.querySelector ? e.target.querySelector('[data-rv]') : null;
      if (e.target.matches && e.target.matches('[data-rv]')) el = e.target;
      if (el) {
        el.__rvInit = false;
        initSection(el);
      }
    });
  })();
{% endjavascript %}

{% schema %}
{
  "name": "Recently viewed",
  "tag": "section",
  "class": "section-recently-viewed",
  "settings": [
    {
      "type": "paragraph",
      "content": "Shows each visitor the products they recently viewed, tracked privately in their browser. It stays hidden until there is something to show."
    },

    { "type": "header", "content": "Heading" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Keep exploring" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Recently viewed" },
    { "type": "textarea", "id": "subheading", "label": "Subheading" },
    {
      "type": "select",
      "id": "heading_align",
      "label": "Heading alignment",
      "default": "left",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ]
    },

    { "type": "header", "content": "Products" },
    {
      "type": "range",
      "id": "products_limit",
      "label": "Max products to show",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 4
    },

    { "type": "header", "content": "Grid" },
    { "type": "range", "id": "columns", "label": "Columns — desktop", "min": 2, "max": 6, "step": 1, "default": 4 },
    {
      "type": "range",
      "id": "columns_tablet",
      "label": "Columns — tablet",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "range",
      "id": "columns_mobile",
      "label": "Columns — mobile",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 1
    },

    { "type": "header", "content": "Section" },
    { "type": "color", "id": "bg_color", "label": "Background colour", "default": "#FFFFFF" },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 72
    },
    { "type": "text", "id": "anchor_id", "label": "Anchor id", "default": "recently-viewed" },

    { "type": "header", "content": "Card" },
    { "type": "color", "id": "card_bg", "label": "Card background", "default": "#FFFFFF" },
    { "type": "color", "id": "card_border_color", "label": "Card border", "default": "#EDE6D6" },
    {
      "type": "range",
      "id": "card_radius",
      "label": "Card corner radius",
      "min": 0,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 10
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image ratio",
      "default": "1/1",
      "options": [
        { "value": "1/1", "label": "Square" },
        { "value": "4/5", "label": "Portrait (4:5)" },
        { "value": "3/4", "label": "Portrait (3:4)" },
        { "value": "5/4", "label": "Landscape (5:4)" },
        { "value": "4/3", "label": "Landscape (4:3)" }
      ]
    },

    { "type": "header", "content": "Product info" },
    { "type": "checkbox", "id": "show_vendor", "label": "Show vendor", "default": true },
    { "type": "color", "id": "vendor_color", "label": "Vendor colour", "default": "#BE9743" },
    { "type": "color", "id": "title_color", "label": "Title colour", "default": "#251D3A" },
    {
      "type": "range",
      "id": "title_size",
      "label": "Title size — desktop",
      "min": 13,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    { "type": "color", "id": "price_color", "label": "Price colour", "default": "#251D3A" },
    { "type": "color", "id": "compare_price_color", "label": "Compare-at price colour", "default": "#8B8398" },

    {
      "type": "header",
      "content": "Rating badge",
      "info": "Shown automatically when a product has a review rating (e.g. via a reviews app)."
    },
    { "type": "checkbox", "id": "show_rating", "label": "Show rating badge", "default": true },
    { "type": "color", "id": "rating_text_color", "label": "Badge text & star colour", "default": "#BE9743" },

    { "type": "header", "content": "Quick view" },
    { "type": "checkbox", "id": "show_quick_view", "label": "Show quick view icon", "default": true },
    { "type": "color", "id": "quickview_icon_color", "label": "Icon colour", "default": "#251D3A" },

    { "type": "header", "content": "Quick add" },
    {
      "type": "select",
      "id": "quick_add_style",
      "label": "Add to cart button",
      "default": "hover",
      "options": [
        { "value": "hover", "label": "Show on hover (always on touch devices)" },
        { "value": "always", "label": "Always visible" },
        { "value": "none", "label": "Hidden" }
      ]
    },
    { "type": "color", "id": "quick_add_bg_color", "label": "Button background", "default": "#251D3A" },
    { "type": "color", "id": "quick_add_text_color", "label": "Button text", "default": "#FDFBF3" },
    {
      "type": "range",
      "id": "quick_add_radius",
      "label": "Button corner radius",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 30
    },

    {
      "type": "header",
      "content": "Image dots",
      "info": "A decorative indicator shown when a product has more than one image."
    },
    { "type": "checkbox", "id": "show_image_dots", "label": "Show image dots", "default": true },
    { "type": "color", "id": "dot_active_color", "label": "Active dot colour", "default": "#BE9743" }
  ],
  "presets": [{ "name": "Recently viewed" }]
}
{% endschema %}
