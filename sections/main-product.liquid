<div class="page-shell wrap">
  <nav class="breadcrumb"><a href="{{ routes.root_url }}">Home</a> / {{ product.title }}</nav>
  <div class="product">
    <div class="product__gallery">
      {%- if product.featured_media -%}
        <img id="product-hero" src="{{ product.featured_media | image_url: width: 1200 }}" alt="{{ product.featured_media.alt | default: product.title | escape }}" width="600" height="600">
      {%- endif -%}
      {%- if product.media.size > 1 -%}
        <div class="product__thumbs">
          {%- for media in product.media limit: 6 -%}
            <img src="{{ media | image_url: width: 200 }}" alt="{{ media.alt | escape }}" loading="lazy" onclick="document.getElementById('product-hero').src=this.src.replace('width=200','width=1200')">
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    <div class="product__info">
      <span class="eyebrow">{{ product.type | default: 'Vision of the Bible' }}</span>
      <h1>{{ product.title }}</h1>
      <div class="product__price">
        {%- if product.compare_at_price > product.price -%}<s>{{ product.compare_at_price | money }}</s>{%- endif -%}
        {{ product.price | money }}
      </div>

      {%- form 'product', product -%}
        <div class="product__form">
          {%- if product.has_only_default_variant -%}
            <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
          {%- else -%}
            <div>
              <label for="variant-select">Options</label><br>
              <select id="variant-select" name="id">
                {%- for variant in product.variants -%}
                  <option value="{{ variant.id }}"{% if variant == product.selected_or_first_available_variant %} selected{% endif %}{% unless variant.available %} disabled{% endunless %}>
                    {{ variant.title }} — {{ variant.price | money }}{% unless variant.available %} ({{ 'products.product.sold_out' | t }}){% endunless %}
                  </option>
                {%- endfor -%}
              </select>
            </div>
          {%- endif -%}
          <div class="qty">
            <label for="quantity">{{ 'products.product.quantity' | t }}</label>
            <input type="number" id="quantity" name="quantity" value="1" min="1">
          </div>
        </div>
        <button type="submit" class="btn btn--primary" {% unless product.available %}disabled{% endunless %}>
          {%- if product.available -%}{{ 'products.product.add_to_cart' | t }}{%- else -%}{{ 'products.product.sold_out' | t }}{%- endif -%}
        </button>
      {%- endform -%}

      {%- if product.description != blank -%}
        <div class="rte" style="margin-top:2rem">{{ product.description }}</div>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Product page",
  "settings": [],
  "blocks": []
}
{% endschema %}
