{%- comment -%}
  ============================================================
  You may also like — related products
  ------------------------------------------------------------
  Uses Shopify's Product Recommendations API (algorithmically
  related products). Because recommendations aren't available on
  the first server render, the section renders empty and then
  fetches itself through the recommendations endpoint with the
  Section Rendering API, swapping in the result.

  Fallback: if Shopify returns no recommendations, it shows other
  products from a fallback collection (a collection you choose, or
  else the product's own first collection), excluding this product.
  If there is still nothing to show, the section stays hidden.
  ============================================================
{%- endcomment -%}

{%- liquid
  assign s = section.settings
  assign limit = s.products_limit | default: 4
  assign intent = s.intent | default: 'related'

  assign source = 'rec'
  assign use_list = recommendations.products
  if recommendations.performed and recommendations.products_count == 0
    assign source = 'fallback'
    assign fb = s.fallback_collection
    if fb == blank
      assign fb = product.collections.first
    endif
    assign use_list = fb.products
  endif
-%}

{% style %}
  #shopify-section-{{ section.id }} .rel{
    --rel-cols: {{ s.columns | default: 4 }};
    --rel-cols-tablet: {{ s.columns_tablet | default: 3 }};
    --rel-cols-mobile: {{ s.columns_mobile | default: 1 }};
    --rel-bg: {{ s.bg_color | default: '#ffffff' }};
    --rel-pad-t: {{ s.padding_top | default: 24 }}px;
    --rel-pad-b: {{ s.padding_bottom | default: 88 }}px;
    /* Card custom properties read by snippets/product-card.liquid (styles in best-seller.css) */
    --bs-card-bg: {{ s.card_bg | default: '#ffffff' }};
    --bs-card-border: {{ s.card_border_color | default: '#ede6d6' }};
    --bs-card-radius: {{ s.card_radius | default: 10 }}px;
    --bs-img-ratio: {{ s.image_ratio | default: '1/1' }};
    --bs-vendor-color: {{ s.vendor_color | default: '#be9743' }};
    --bs-title-color: {{ s.title_color | default: '#251d3a' }};
    --bs-title-size: {{ s.title_size | default: 16 }}px;
    --bs-price-color: {{ s.price_color | default: '#251d3a' }};
    --bs-compare-color: {{ s.compare_price_color | default: '#8b8398' }};
    --bs-rating-color: {{ s.rating_text_color | default: '#be9743' }};
    --bs-quickview-color: {{ s.quickview_icon_color | default: '#251d3a' }};
    --bs-cta-bg: {{ s.quick_add_bg_color | default: '#251d3a' }};
    --bs-cta-color: {{ s.quick_add_text_color | default: '#fdfbf3' }};
    --bs-cta-radius: {{ s.quick_add_radius | default: 30 }}px;
    --bs-dot-active: {{ s.dot_active_color | default: '#be9743' }};
  }
  @media (max-width: 749px){
    #shopify-section-{{ section.id }} .rel{
      --rel-pad-t: {{ s.padding_top | default: 24 | times: 0.8 | round }}px;
      --rel-pad-b: {{ s.padding_bottom | default: 88 | times: 0.7 | round }}px;
    }
  }
{% endstyle %}

<section
  class="rel wrap"
  id="{{ s.anchor_id | default: 'related-products' }}"
  data-rel
  data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ limit }}&intent={{ intent }}"
  {% unless recommendations.performed %}
    data-rel-fetch
  {% endunless %}
  hidden
>
  {%- if recommendations.performed -%}
    <div class="rel__head rel__head--{{ s.heading_align | default: 'left' }}">
      {%- if s.eyebrow != blank -%}
        <span class="eyebrow{% if s.heading_align == 'center' %} eyebrow-center{% else %} eyebrow-left{% endif %}">
          {{- s.eyebrow -}}
        </span>
      {%- endif -%}
      {%- if s.heading != blank -%}
        <h2 class="rel__heading">{{ s.heading }}</h2>
      {%- endif -%}
      {%- if s.subheading != blank -%}
        <p class="rel__sub">{{ s.subheading }}</p>
      {%- endif -%}
    </div>

    <div class="rel__grid" data-rel-grid role="list">
      {%- assign shown = 0 -%}
      {%- for p in use_list -%}
        {%- if source == 'fallback' and product != blank and p.id == product.id -%}{%- continue -%}{%- endif -%}
        {%- render 'product-card', product: p, settings: s -%}
        {%- assign shown = shown | plus: 1 -%}
        {%- if shown >= limit -%}{%- break -%}{%- endif -%}
      {%- endfor -%}
    </div>
  {%- endif -%}
</section>

{% stylesheet %}
  .rel {
    background: var(--rel-bg);
    padding-top: var(--rel-pad-t);
    padding-bottom: var(--rel-pad-b);
  }
  .rel[hidden] {
    display: none;
  }
  .rel__head {
    margin: 0 0 2rem;
  }
  .rel__head--center {
    text-align: center;
  }
  .rel__head--center .eyebrow {
    justify-content: center;
  }
  .rel__heading {
    font-family: var(--display, 'Fraunces', Georgia, serif);
    font-weight: 400;
    font-size: clamp(1.7rem, 3vw, 2.5rem);
    line-height: 1.08;
    margin: 0.9rem 0 0;
    color: var(--ink);
  }
  .rel__sub {
    margin: 0.6rem 0 0;
    color: var(--ink-soft);
    font-size: 1.06rem;
  }

  .rel__grid {
    display: grid;
    grid-template-columns: repeat(var(--rel-cols, 4), minmax(0, 1fr));
    gap: clamp(14px, 2vw, 22px);
  }
  @media (max-width: 989px) {
    .rel__grid {
      grid-template-columns: repeat(var(--rel-cols-tablet, 3), minmax(0, 1fr));
    }
  }
  @media (max-width: 620px) {
    .rel__grid {
      grid-template-columns: repeat(var(--rel-cols-mobile, 1), minmax(0, 1fr));
    }
  }
{% endstylesheet %}

{% javascript %}
  (function () {
    'use strict';

    function hasCards(el) {
      var grid = el.querySelector('[data-rel-grid]');
      return !!(grid && grid.children.length);
    }

    function fetchRecs(el) {
      if (el.__relDone) return;
      el.__relDone = true;
      var url = el.getAttribute('data-url');
      if (!url) return;

      fetch(url)
        .then(function (r) {
          return r.ok ? r.text() : null;
        })
        .then(function (html) {
          if (!html) {
            el.hidden = true;
            return;
          }
          var doc = new DOMParser().parseFromString(html, 'text/html');
          var incoming = doc.querySelector('[data-rel]');
          if (!incoming) {
            el.hidden = true;
            return;
          }
          el.innerHTML = incoming.innerHTML;
          /* Cards are injected after theme-reveal.js has already run, so reveal
           them immediately instead of leaving them stuck at opacity 0. */
          el.querySelectorAll('.reveal').forEach(function (n) {
            n.classList.add('in');
          });
          el.removeAttribute('data-rel-fetch');
          el.hidden = !hasCards(el);
        })
        .catch(function () {
          el.hidden = true;
        });
    }

    function initSection(el) {
      if (!el) return;
      if (el.hasAttribute('data-rel-fetch')) {
        fetchRecs(el);
      } else {
        /* Already rendered server-side (e.g. recommendations were available) */
        el.hidden = !hasCards(el);
      }
    }

    function boot() {
      document.querySelectorAll('[data-rel]').forEach(initSection);
    }
    if (document.readyState !== 'loading') boot();
    else document.addEventListener('DOMContentLoaded', boot);

    document.addEventListener('shopify:section:load', function (e) {
      var el = e.target.querySelector ? e.target.querySelector('[data-rel]') : null;
      if (e.target.matches && e.target.matches('[data-rel]')) el = e.target;
      if (el) {
        el.__relDone = false;
        initSection(el);
      }
    });
  })();
{% endjavascript %}

{% schema %}
{
  "name": "You may also like",
  "tag": "section",
  "class": "section-related-products",
  "settings": [
    {
      "type": "paragraph",
      "content": "Shows products related to the one being viewed, powered by Shopify's recommendations. Falls back to a collection when no recommendations are available."
    },

    { "type": "header", "content": "Heading" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "You may also like" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "More to discover" },
    { "type": "textarea", "id": "subheading", "label": "Subheading" },
    {
      "type": "select",
      "id": "heading_align",
      "label": "Heading alignment",
      "default": "left",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ]
    },

    { "type": "header", "content": "Recommendations" },
    {
      "type": "select",
      "id": "intent",
      "label": "Recommendation type",
      "default": "related",
      "options": [
        { "value": "related", "label": "Related products" },
        { "value": "complementary", "label": "Complementary products" }
      ],
      "info": "\"Complementary\" needs the Search & Discovery app configured; otherwise use Related."
    },
    {
      "type": "range",
      "id": "products_limit",
      "label": "Max products to show",
      "min": 2,
      "max": 10,
      "step": 1,
      "default": 4
    },
    {
      "type": "collection",
      "id": "fallback_collection",
      "label": "Fallback collection",
      "info": "Used only when Shopify returns no recommendations. Leave empty to fall back to this product's own collection."
    },

    { "type": "header", "content": "Grid" },
    { "type": "range", "id": "columns", "label": "Columns — desktop", "min": 2, "max": 6, "step": 1, "default": 4 },
    {
      "type": "range",
      "id": "columns_tablet",
      "label": "Columns — tablet",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "range",
      "id": "columns_mobile",
      "label": "Columns — mobile",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 1
    },

    { "type": "header", "content": "Card" },
    { "type": "color", "id": "card_bg", "label": "Card background", "default": "#FFFFFF" },
    { "type": "color", "id": "card_border_color", "label": "Card border", "default": "#EDE6D6" },
    {
      "type": "range",
      "id": "card_radius",
      "label": "Card corner radius",
      "min": 0,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 10
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image ratio",
      "default": "1/1",
      "options": [
        { "value": "1/1", "label": "Square" },
        { "value": "4/5", "label": "Portrait (4:5)" },
        { "value": "3/4", "label": "Portrait (3:4)" },
        { "value": "5/4", "label": "Landscape (5:4)" },
        { "value": "4/3", "label": "Landscape (4:3)" }
      ]
    },

    { "type": "header", "content": "Product info" },
    { "type": "checkbox", "id": "show_vendor", "label": "Show vendor", "default": true },
    { "type": "color", "id": "vendor_color", "label": "Vendor colour", "default": "#BE9743" },
    { "type": "color", "id": "title_color", "label": "Title colour", "default": "#251D3A" },
    {
      "type": "range",
      "id": "title_size",
      "label": "Title size — desktop",
      "min": 13,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    { "type": "color", "id": "price_color", "label": "Price colour", "default": "#251D3A" },
    { "type": "color", "id": "compare_price_color", "label": "Compare-at price colour", "default": "#8B8398" },

    {
      "type": "header",
      "content": "Rating badge",
      "info": "Shown automatically when a product has a review rating (e.g. via a reviews app)."
    },
    { "type": "checkbox", "id": "show_rating", "label": "Show rating badge", "default": true },
    { "type": "color", "id": "rating_text_color", "label": "Badge text & star colour", "default": "#BE9743" },

    { "type": "header", "content": "Quick view" },
    { "type": "checkbox", "id": "show_quick_view", "label": "Show quick view icon", "default": true },
    { "type": "color", "id": "quickview_icon_color", "label": "Icon colour", "default": "#251D3A" },

    { "type": "header", "content": "Quick add" },
    {
      "type": "select",
      "id": "quick_add_style",
      "label": "Add to cart button",
      "default": "hover",
      "options": [
        { "value": "hover", "label": "Show on hover (always on touch devices)" },
        { "value": "always", "label": "Always visible" },
        { "value": "none", "label": "Hidden" }
      ]
    },
    { "type": "color", "id": "quick_add_bg_color", "label": "Button background", "default": "#251D3A" },
    { "type": "color", "id": "quick_add_text_color", "label": "Button text", "default": "#FDFBF3" },
    {
      "type": "range",
      "id": "quick_add_radius",
      "label": "Button corner radius",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 30
    },

    {
      "type": "header",
      "content": "Image dots",
      "info": "A decorative indicator shown when a product has more than one image."
    },
    { "type": "checkbox", "id": "show_image_dots", "label": "Show image dots", "default": true },
    { "type": "color", "id": "dot_active_color", "label": "Active dot colour", "default": "#BE9743" },

    { "type": "header", "content": "Section" },
    { "type": "color", "id": "bg_color", "label": "Background colour", "default": "#FFFFFF" },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 88
    },
    { "type": "text", "id": "anchor_id", "label": "Anchor id", "default": "related-products" }
  ],
  "presets": [{ "name": "You may also like" }]
}
{% endschema %}
