{%- liquid
  assign s = section.settings

  comment
    Resolve banner artwork. An uploaded image wins; the text URL is the fallback,
    matching the pattern used in sections/about-panels.liquid. Mobile falls back
    to the desktop artwork when nothing mobile-specific is provided.
  endcomment
  assign has_desktop_img = false
  if s.image_desktop != blank or s.image_desktop_url != blank
    assign has_desktop_img = true
  endif

  assign has_mobile_img = false
  if s.image_mobile != blank or s.image_mobile_url != blank
    assign has_mobile_img = true
  endif

  comment
    Overlay colour at two strengths. The gradients never fall to fully transparent
    across the middle of the banner: a light photograph behind white headline text
    is otherwise unreadable. `mid` is 45% of the chosen opacity — enough to hold
    text legibility while the artwork still reads.
  endcomment
  assign overlay_base = s.overlay_color | default: '#1B0F33'

  assign overlay_alpha = s.overlay_opacity | times: 0.01
  assign overlay_alpha_mid = overlay_alpha | times: 0.45
  assign overlay_rgba = overlay_base | color_modify: 'alpha', overlay_alpha
  assign overlay_mid = overlay_base | color_modify: 'alpha', overlay_alpha_mid

  assign overlay_alpha_m = s.overlay_opacity_mobile | times: 0.01
  assign overlay_alpha_mid_m = overlay_alpha_m | times: 0.45
  assign overlay_rgba_m = overlay_base | color_modify: 'alpha', overlay_alpha_m
  assign overlay_mid_m = overlay_base | color_modify: 'alpha', overlay_alpha_mid_m

  assign overlay_style_m = s.overlay_style_mobile
  if overlay_style_m == 'inherit'
    assign overlay_style_m = s.overlay_style
  endif
-%}

{%- capture overlay_bg -%}
  {%- case s.overlay_style -%}
    {%- when 'solid' -%}{{ overlay_rgba }}
    {%- when 'scrim_bottom' -%}linear-gradient(to top, {{ overlay_rgba }} 0%, {{ overlay_mid }} 45%, transparent 88%)
    {%- when 'scrim_both' -%}linear-gradient(to bottom, {{ overlay_rgba }} 0%, {{ overlay_mid }} 38%, {{ overlay_mid }} 62%, {{ overlay_rgba }} 100%)
    {%- when 'scrim_left' -%}linear-gradient(to right, {{ overlay_rgba }} 0%, {{ overlay_mid }} 52%, transparent 88%)
  {%- endcase -%}
{%- endcapture -%}

{%- capture overlay_bg_mobile -%}
  {%- case overlay_style_m -%}
    {%- when 'solid' -%}{{ overlay_rgba_m }}
    {%- when 'scrim_bottom' -%}linear-gradient(to top, {{ overlay_rgba_m }} 0%, {{ overlay_mid_m }} 45%, transparent 88%)
    {%- when 'scrim_both' -%}linear-gradient(to bottom, {{ overlay_rgba_m }} 0%, {{ overlay_mid_m }} 38%, {{ overlay_mid_m }} 62%, {{ overlay_rgba_m }} 100%)
    {%- when 'scrim_left' -%}linear-gradient(to right, {{ overlay_rgba_m }} 0%, {{ overlay_mid_m }} 52%, transparent 88%)
  {%- endcase -%}
{%- endcapture -%}

{%- liquid
  # Background layer shown behind the artwork, and on its own when no image is set
  if s.bg_gradient_enable
    assign glow_1_alpha = s.bg_glow_1_opacity | times: 0.01
    assign glow_2_alpha = s.bg_glow_2_opacity | times: 0.01
    assign glow_1 = s.bg_glow_1_color | color_modify: 'alpha', glow_1_alpha
    assign glow_2 = s.bg_glow_2_color | color_modify: 'alpha', glow_2_alpha
  endif

  # Image treatment. Blur bleeds transparent edges into a cover-fitted image, so
  # the scale is nudged up to compensate whenever blur is in play.
  assign zoom_scale = s.image_zoom | times: 0.01
  assign blur_comp = s.image_blur | times: 0.03 | plus: 1
  assign img_scale = zoom_scale
  if blur_comp > zoom_scale
    assign img_scale = blur_comp
  endif

  assign img_filter = 'none'
  if s.image_blur > 0 or s.image_brightness != 100
    assign brightness_val = s.image_brightness | times: 0.01
    capture img_filter
      echo 'brightness('
      echo brightness_val
      echo ') blur('
      echo s.image_blur
      echo 'px)'
    endcapture
  endif

  # Horizontal placement of the text column
  case s.text_align
    when 'center'
      assign margin_start = 'auto'
      assign margin_end = 'auto'
      assign trust_justify = 'center'
    when 'right'
      assign margin_start = 'auto'
      assign margin_end = '0'
      assign trust_justify = 'flex-end'
    else
      assign margin_start = '0'
      assign margin_end = 'auto'
      assign trust_justify = 'flex-start'
  endcase

  case s.text_align_mobile
    when 'center'
      assign margin_start_m = 'auto'
      assign margin_end_m = 'auto'
      assign trust_justify_m = 'center'
    when 'right'
      assign margin_start_m = 'auto'
      assign margin_end_m = '0'
      assign trust_justify_m = 'flex-end'
    when 'left'
      assign margin_start_m = '0'
      assign margin_end_m = 'auto'
      assign trust_justify_m = 'flex-start'
  endcase

  case s.content_position
    when 'top'
      assign align_items = 'start'
    when 'bottom'
      assign align_items = 'end'
    else
      assign align_items = 'center'
  endcase

  case s.content_position_mobile
    when 'top'
      assign align_items_m = 'start'
    when 'bottom'
      assign align_items_m = 'end'
    when 'middle'
      assign align_items_m = 'center'
  endcase

  case s.heading_font
    when 'serif'
      assign heading_font_stack = 'var(--serif)'
    else
      assign heading_font_stack = 'var(--display)'
  endcase

  # Focal point keywords mapped to object-position values
  case s.image_position
    when 'top'
      assign focal = 'center top'
    when 'bottom'
      assign focal = 'center bottom'
    when 'left'
      assign focal = 'left center'
    when 'right'
      assign focal = 'right center'
    else
      assign focal = 'center center'
  endcase

  case s.image_position_mobile
    when 'top'
      assign focal_mobile = 'center top'
    when 'bottom'
      assign focal_mobile = 'center bottom'
    when 'left'
      assign focal_mobile = 'left center'
    when 'right'
      assign focal_mobile = 'right center'
    else
      assign focal_mobile = 'center center'
  endcase

  if s.text_shadow
    assign heading_shadow = '0 2px 30px rgba(0,0,0,.38)'
    assign sub_shadow = '0 1px 18px rgba(0,0,0,.34)'
  else
    assign heading_shadow = 'none'
    assign sub_shadow = 'none'
  endif

  # Trailing gap under the subtitle only earns its space when a paragraph or trust row follows
  assign sub_gap = 0
  assign sub_gap_mobile = 0
  if s.paragraph != blank or s.trust_enable
    assign sub_gap = s.subtitle_gap
    assign sub_gap_mobile = s.subtitle_gap_mobile
  endif

  # Trailing gap under the paragraph only when the trust row follows
  assign para_gap = 0
  assign para_gap_mobile = 0
  if s.trust_enable
    assign para_gap = s.paragraph_gap
    assign para_gap_mobile = s.paragraph_gap_mobile
  endif

  # Moto alignment follows the text column unless overridden
  assign moto_align = s.moto_align
  if moto_align == 'inherit'
    assign moto_align = s.text_align
  endif
  assign moto_align_mobile = s.moto_align_mobile
  if moto_align_mobile == 'inherit'
    if s.text_align_mobile != 'inherit'
      assign moto_align_mobile = s.text_align_mobile
    else
      assign moto_align_mobile = moto_align
    endif
  endif

  assign heading_tag = s.heading_tag | default: 'h1'
-%}

{% style %}
  #shopify-section-{{ section.id }} .hero{
    --hero-h-fallback: {{ s.height_desktop }}vh;
    --hero-h: {{ s.height_desktop }}svh;
    --hero-bg-color: {{ s.bg_color }};
    {% if s.bg_gradient_enable %}--hero-bg-image:
      radial-gradient(65% 85% at 84% 12%, {{ glow_1 }}, transparent 55%),
      radial-gradient(85% 100% at 8% 100%, {{ glow_2 }}, transparent 60%),
      linear-gradient({{ s.bg_gradient_angle }}deg, {{ s.bg_gradient_start }} 0%, {{ s.bg_gradient_mid }} 46%, {{ s.bg_gradient_end }} 100%);
    {% else %}--hero-bg-image: none;{% endif %}
    --hero-focal: {{ focal }};
    --hero-fit: {{ s.image_fit }};
    --hero-img-scale: {{ img_scale }};
    --hero-img-filter: {{ img_filter }};
    --hero-align-items: {{ align_items }};
    --hero-text-align: {{ s.text_align }};
    --hero-h1-w: {{ s.heading_width }}px;
    --hero-sub-w: {{ s.subtitle_width }}px;
    --hero-para-w: {{ s.paragraph_width }}px;
    --hero-ms: {{ margin_start }};
    --hero-me: {{ margin_end }};
    --hero-pt: {{ s.padding_top }}px;
    --hero-pb: {{ s.padding_bottom }}px;
    --hero-h1-font: {{ heading_font_stack }};
    --hero-h1-size: {{ s.heading_size_desktop }}px;
    --hero-h1-lh: {{ s.heading_lh_desktop | times: 0.01 }};
    --hero-h1-color: {{ s.heading_color }};
    --hero-h1-accent: {{ s.heading_accent_color }};
    --hero-h1-shadow: {{ heading_shadow }};
    --hero-h1-pt: {{ s.heading_pt }}px;
    --hero-h1-gap: {{ s.heading_gap }}px;
    --hero-sub-size: {{ s.subtitle_size_desktop }}px;
    --hero-sub-lh: {{ s.subtitle_lh_desktop | times: 0.01 }};
    --hero-sub-color: {{ s.subtitle_color }};
    --hero-sub-shadow: {{ sub_shadow }};
    --hero-sub-pt: {{ s.subtitle_pt }}px;
    --hero-sub-gap: {{ sub_gap }}px;
    --hero-para-size: {{ s.paragraph_size_desktop }}px;
    --hero-para-lh: {{ s.paragraph_lh_desktop | times: 0.01 }};
    --hero-para-color: {{ s.paragraph_color }};
    --hero-para-pt: {{ s.paragraph_pt }}px;
    --hero-para-gap: {{ para_gap }}px;
    --hero-moto-gap: {{ s.moto_gap }}px;
    --hero-moto-pt: {{ s.moto_pt }}px;
    --hero-trust-pt: {{ s.trust_pt }}px;
    --hero-trust-gap: {{ s.trust_gap }}px;
    --hero-trust-justify: {{ trust_justify }};
    {% if overlay_bg != blank %}--hero-overlay-bg: {{ overlay_bg }};{% endif %}
  }

  @media (max-width: 749px){
    #shopify-section-{{ section.id }} .hero{
      --hero-h-fallback: {{ s.height_mobile }}vh;
      --hero-h: {{ s.height_mobile }}svh;
      --hero-focal: {{ focal_mobile }};
      --hero-pt: {{ s.padding_top_mobile }}px;
      --hero-pb: {{ s.padding_bottom_mobile }}px;
      --hero-h1-size: {{ s.heading_size_mobile }}px;
      --hero-h1-lh: {{ s.heading_lh_mobile | times: 0.01 }};
      --hero-h1-pt: {{ s.heading_pt_mobile }}px;
      --hero-h1-gap: {{ s.heading_gap_mobile }}px;
      --hero-sub-size: {{ s.subtitle_size_mobile }}px;
      --hero-sub-lh: {{ s.subtitle_lh_mobile | times: 0.01 }};
      --hero-sub-pt: {{ s.subtitle_pt_mobile }}px;
      --hero-sub-gap: {{ sub_gap_mobile }}px;
      --hero-para-size: {{ s.paragraph_size_mobile }}px;
      --hero-para-lh: {{ s.paragraph_lh_mobile | times: 0.01 }};
      --hero-para-pt: {{ s.paragraph_pt_mobile }}px;
      --hero-para-gap: {{ para_gap_mobile }}px;
      --hero-moto-gap: {{ s.moto_gap_mobile }}px;
      --hero-moto-pt: {{ s.moto_pt_mobile }}px;
      --hero-trust-pt: {{ s.trust_pt_mobile }}px;
      --hero-trust-gap: {{ s.trust_gap_mobile }}px;
      --hero-h1-w: {{ s.heading_width_mobile }}px;
      --hero-sub-w: {{ s.subtitle_width_mobile }}px;
      --hero-para-w: {{ s.paragraph_width_mobile }}px;
      {% if s.text_align_mobile != 'inherit' %}--hero-text-align: {{ s.text_align_mobile }};
      --hero-ms: {{ margin_start_m }};
      --hero-me: {{ margin_end_m }};
      --hero-trust-justify: {{ trust_justify_m }};{% endif %}
      {% if s.content_position_mobile != 'inherit' %}--hero-align-items: {{ align_items_m }};{% endif %}
      {% if overlay_bg_mobile != blank %}--hero-overlay-bg: {{ overlay_bg_mobile }};{% endif %}
      {% unless s.show_motes_mobile %}--hero-motes-display: none;{% endunless %}
    }
  }
{% endstyle %}

<section
  class="hero{% if s.bg_parallax and has_desktop_img or s.bg_parallax and has_mobile_img %} hero--parallax{% endif %}"
  id="{{ s.anchor_id | default: 'hero' }}"
>
  {%- if has_desktop_img or has_mobile_img -%}
    <picture class="hero__media">
      {%- if has_mobile_img -%}
        {%- if s.image_mobile != blank -%}
          <source
            media="(max-width: 749px)"
            srcset="
              {{ s.image_mobile | image_url: width: 480 }} 480w,
              {{ s.image_mobile | image_url: width: 750 }} 750w,
              {{ s.image_mobile | image_url: width: 1100 }} 1100w,
              {{ s.image_mobile | image_url: width: 1500 }} 1500w
            "
            sizes="100vw"
            width="{{ s.image_mobile.width }}"
            height="{{ s.image_mobile.height }}"
          >
        {%- else -%}
          <source media="(max-width: 749px)" srcset="{{ s.image_mobile_url }}">
        {%- endif -%}
      {%- endif -%}

      {%- if s.image_desktop != blank -%}
        <img
          src="{{ s.image_desktop | image_url: width: 1600 }}"
          srcset="
            {{ s.image_desktop | image_url: width: 640 }} 640w,
            {{ s.image_desktop | image_url: width: 960 }} 960w,
            {{ s.image_desktop | image_url: width: 1280 }} 1280w,
            {{ s.image_desktop | image_url: width: 1600 }} 1600w,
            {{ s.image_desktop | image_url: width: 2000 }} 2000w,
            {{ s.image_desktop | image_url: width: 2400 }} 2400w
          "
          sizes="100vw"
          width="{{ s.image_desktop.width }}"
          height="{{ s.image_desktop.height }}"
          alt="{{ s.image_alt | escape }}"
          fetchpriority="high"
          decoding="async"
        >
      {%- elsif s.image_desktop_url != blank -%}
        <img
          src="{{ s.image_desktop_url }}"
          width="{{ s.image_desktop.width }}"
          height="{{ s.image_desktop.height }}"
          alt="{{ s.image_alt | escape }}"
          fetchpriority="high"
          decoding="async"
        >
      {%- else -%}
        {%- comment -%} Mobile-only artwork: reuse it as the <img> so <picture> has a base. {%- endcomment -%}
        {%- if s.image_mobile != blank -%}
          <img
            src="{{ s.image_mobile | image_url: width: 1500 }}"
            width="{{ s.image_mobile.width }}"
            height="{{ s.image_mobile.height }}"
            alt="{{ s.image_alt | escape }}"
            fetchpriority="high"
            decoding="async"
          >
        {%- else -%}
          <img
            src="{{ s.image_mobile_url }}"
            width="{{ s.image_mobile.width }}"
            height="{{ s.image_mobile.height }}"
            alt="{{ s.image_alt | escape }}"
            fetchpriority="high"
            decoding="async"
          >
        {%- endif -%}
      {%- endif -%}
    </picture>
  {%- endif -%}

  {%- if overlay_bg != blank or overlay_bg_mobile != blank -%}
    <div class="hero__overlay" aria-hidden="true"></div>
  {%- endif -%}

  <div class="hero__inner wrap">
    <div class="hero__content">
      {%- if s.moto_enable and s.moto_text != blank -%}
        <span class="eyebrow{% if moto_align == 'center' %} eyebrow-center{% else %} eyebrow-left{% endif %}">
          {{- s.moto_text | escape -}}
        </span>
      {%- endif -%}

      {%- if s.title != blank -%}
        <{{ heading_tag }} class="hero__title">{{ s.title }}</{{ heading_tag }}>
      {%- endif -%}

      {%- if s.subtitle != blank -%}
        <p class="hero__sub">{{ s.subtitle }}</p>
      {%- endif -%}

      {%- if s.paragraph != blank -%}
        <div class="hero__para">{{ s.paragraph }}</div>
      {%- endif -%}

      {% render 'trust-badges', section: section, class: 'hero__trust' %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero banner",
  "tag": "section",
  "settings": [
    { "type": "header", "content": "Motto" },
    { "type": "checkbox", "id": "moto_enable", "label": "Show motto", "default": true },
    { "type": "text", "id": "moto_text", "label": "Motto text", "default": "THE WORD, MADE VIVID" },
    {
      "type": "select",
      "id": "moto_align",
      "label": "Motto alignment (desktop)",
      "default": "inherit",
      "options": [
        { "value": "inherit", "label": "Same as text" },
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ]
    },
    {
      "type": "select",
      "id": "moto_align_mobile",
      "label": "Motto alignment (mobile)",
      "default": "inherit",
      "options": [
        { "value": "inherit", "label": "Same as text" },
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ]
    },

    {
      "type": "inline_richtext",
      "id": "title",
      "label": "Heading",
      "info": "Use italics to highlight a word in the accent colour.",
      "default": "Where Bible stories inspire young minds and strengthen faith"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Vision of the Bible brings the timeless stories and truths of Scripture to life through vivid, faithful visual storytelling — made for the youngest hearts and the wisest ones alike."
    },
    {
      "type": "richtext",
      "id": "paragraph",
      "label": "Paragraph",
      "info": "Optional supporting copy below the subtitle. Supports bold, italics and links."
    },

    { "type": "header", "content": "Trust badges" },
    { "type": "checkbox", "id": "trust_enable", "label": "Show trust badges", "default": true },
    { "type": "text", "id": "trust_label", "label": "Label", "default": "TRUSTED BY FAMILIES ON" },
    { "type": "color", "id": "trust_label_color", "label": "Label colour", "default": "#C4A574" },
    { "type": "color", "id": "trust_text_color", "label": "Badge text colour", "default": "#3A3550" },
    { "type": "color", "id": "trust_star_color", "label": "Star colour", "default": "#F5B400" },

    { "type": "header", "content": "Banner image" },
    {
      "type": "image_picker",
      "id": "image_desktop",
      "label": "Desktop image",
      "info": "Recommended 2400 × 1400px or wider. If empty, the background below is used."
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Mobile image",
      "info": "Shown at 749px and below. Falls back to the desktop image."
    },
    {
      "type": "text",
      "id": "image_desktop_url",
      "label": "Desktop image URL (fallback)",
      "info": "Used only if no desktop image is uploaded above."
    },
    {
      "type": "text",
      "id": "image_mobile_url",
      "label": "Mobile image URL (fallback)",
      "info": "Used only if no mobile image is uploaded above."
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image alt text",
      "info": "Leave blank if the banner is decorative — the heading already describes the section."
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Focal point (desktop)",
      "default": "center",
      "options": [
        { "value": "center", "label": "Center" },
        { "value": "top", "label": "Top" },
        { "value": "bottom", "label": "Bottom" },
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ]
    },
    {
      "type": "select",
      "id": "image_position_mobile",
      "label": "Focal point (mobile)",
      "default": "center",
      "options": [
        { "value": "center", "label": "Center" },
        { "value": "top", "label": "Top" },
        { "value": "bottom", "label": "Bottom" },
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ]
    },

    { "type": "header", "content": "Image treatment" },
    {
      "type": "select",
      "id": "image_fit",
      "label": "Fit",
      "default": "cover",
      "info": "Cover fills the banner and crops. Contain shows the whole image and reveals the background colour around it.",
      "options": [
        { "value": "cover", "label": "Cover (crop to fill)" },
        { "value": "contain", "label": "Contain (show whole image)" }
      ]
    },
    {
      "type": "range",
      "id": "image_zoom",
      "label": "Zoom",
      "min": 100,
      "max": 150,
      "step": 1,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "image_blur",
      "label": "Blur",
      "min": 0,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 0,
      "info": "Softens a busy photo so text reads. The image is scaled up slightly to hide blurred edges."
    },
    {
      "type": "range",
      "id": "image_brightness",
      "label": "Brightness",
      "min": 40,
      "max": 140,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "checkbox",
      "id": "bg_parallax",
      "label": "Parallax (image stays fixed while scrolling)",
      "default": false,
      "info": "Disabled automatically on mobile and for visitors who prefer reduced motion."
    },

    {
      "type": "header",
      "content": "Background",
      "info": "Sits behind the image, and shows on its own when no image is set."
    },
    { "type": "color", "id": "bg_color", "label": "Background colour", "default": "#FFFFFF" },
    { "type": "checkbox", "id": "bg_gradient_enable", "label": "Show gradient", "default": true },
    { "type": "color", "id": "bg_gradient_start", "label": "Gradient start", "default": "#2A184C" },
    { "type": "color", "id": "bg_gradient_mid", "label": "Gradient middle", "default": "#3A2568" },
    { "type": "color", "id": "bg_gradient_end", "label": "Gradient end", "default": "#FFFFFF" },
    {
      "type": "range",
      "id": "bg_gradient_angle",
      "label": "Gradient angle",
      "min": 0,
      "max": 360,
      "step": 5,
      "unit": "°",
      "default": 150
    },
    {
      "type": "color",
      "id": "bg_glow_1_color",
      "label": "Glow 1 colour",
      "default": "#E4C56C",
      "info": "Soft light in the top-right."
    },
    {
      "type": "range",
      "id": "bg_glow_1_opacity",
      "label": "Glow 1 opacity",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "%",
      "default": 22
    },
    {
      "type": "color",
      "id": "bg_glow_2_color",
      "label": "Glow 2 colour",
      "default": "#7A57C0",
      "info": "Soft light in the bottom-left."
    },
    {
      "type": "range",
      "id": "bg_glow_2_opacity",
      "label": "Glow 2 opacity",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "%",
      "default": 38
    },

    { "type": "header", "content": "Height & overlay" },
    {
      "type": "range",
      "id": "height_desktop",
      "label": "Desktop height",
      "min": 40,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100,
      "info": "Percentage of the viewport height."
    },
    {
      "type": "range",
      "id": "height_mobile",
      "label": "Mobile height",
      "min": 40,
      "max": 100,
