{%- liquid
  assign valid_videos = 0
  for block in section.blocks
    if block.settings.video_url != blank
      assign valid_videos = valid_videos | plus: 1
    endif
  endfor
-%}

{%- if valid_videos > 0 or request.design_mode -%}
  <section
    class="testi wrap"
    id="{{ section.settings.anchor_id | default: 'testimonials' }}"
    style="--testi-cols:{{ section.settings.columns_desktop }};--testi-pt:{{ section.settings.padding_top }}px;--testi-pb:{{ section.settings.padding_bottom }}px;"
  >
    <div class="sec-head reveal">
      {%- if section.settings.eyebrow != blank -%}
        <span class="eyebrow eyebrow-center">{{ section.settings.eyebrow }}</span>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2>{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <p>{{ section.settings.subheading }}</p>
      {%- endif -%}
    </div>

    <div class="testi__grid">
      {%- for block in section.blocks -%}
        {%- liquid
          # Accept any shape of YouTube link: /shorts/, youtu.be/, watch?v=, /embed/, /live/ or a bare ID
          assign video_id = ''
          assign link = block.settings.video_url | strip | split: '#' | first

          if link contains 'watch?v='
            assign video_id = link | split: 'watch?v=' | last
          elsif link contains '/shorts/'
            assign video_id = link | split: '/shorts/' | last
          elsif link contains '/embed/'
            assign video_id = link | split: '/embed/' | last
          elsif link contains '/live/'
            assign video_id = link | split: '/live/' | last
          elsif link contains 'youtu.be/'
            assign video_id = link | split: 'youtu.be/' | last
          elsif link contains '&v='
            assign video_id = link | split: '&v=' | last
          else
            unless link contains '/'
              assign video_id = link
            endunless
          endif

          assign video_id = video_id | split: '?' | first | split: '&' | first | split: '/' | first | strip

          # oar2 is the only variant that reliably returns the full-height vertical frame for Shorts
          assign yt_thumb = 'https://i.ytimg.com/vi/' | append: video_id
          assign thumb = yt_thumb | append: '/oar2.jpg'
          assign thumb_fallbacks = yt_thumb | append: '/oardefault.jpg,' | append: yt_thumb | append: '/maxresdefault.jpg,' | append: yt_thumb | append: '/hqdefault.jpg'

          if block.settings.poster != blank
            assign thumb = block.settings.poster | image_url: width: 720
            assign thumb_fallbacks = ''
          endif

          assign label = block.settings.title | default: section.settings.heading | strip_html
        -%}

        {%- if video_id != blank -%}
          <article class="testi__card reveal" {{ block.shopify_attributes }}>
            <div class="testi__media">
              <img
                class="testi__thumb"
                src="{{ thumb }}"
                {% if thumb_fallbacks != blank %}
                  data-yt-fallbacks="{{ thumb_fallbacks }}"
                {% endif %}
                alt="{{ block.settings.poster.alt | default: label | escape }}"
                loading="lazy"
                decoding="async"
                width="720"
                height="1280"
              >
              <button
                class="testi__facade"
                type="button"
                data-yt-facade
                data-yt-id="{{ video_id | escape }}"
                data-yt-label="{{ label | escape }}"
                aria-label="Play video: {{ label | escape }}"
              >
                <span class="testi__play" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="currentColor">
                    <path d="M8 5v14l11-7z"/>
                  </svg>
                </span>
              </button>
            </div>

            {%- if block.settings.title != blank -%}
              <h3 class="testi__title">{{ block.settings.title }}</h3>
            {%- elsif section.settings.auto_titles -%}
              <h3 class="testi__title" data-yt-autotitle="{{ video_id | escape }}"></h3>
            {%- endif -%}
          </article>
        {%- elsif request.design_mode -%}
          <article class="testi__card reveal" {{ block.shopify_attributes }}>
            <div class="testi__media testi__media--empty">
              <span class="testi__play" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="currentColor">
                  <path d="M8 5v14l11-7z"/>
                </svg>
              </span>
            </div>
            <h3 class="testi__title">{{ block.settings.title | default: 'Paste a YouTube link' }}</h3>
          </article>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Client testimonial",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "In their words" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Client Testimonial" },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Short clips from the families living with Vision of the Bible stories."
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 3,
      "max": 6,
      "step": 1,
      "label": "Videos per row (desktop)",
      "default": 5,
      "info": "Below 1100px the row turns into a swipeable carousel."
    },
    {
      "type": "checkbox",
      "id": "auto_titles",
      "label": "Fetch titles from YouTube",
      "default": true,
      "info": "Used only where a card's title is left empty. Titles are read from YouTube in the visitor's browser."
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 140,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 140,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 56
    },
    { "type": "text", "id": "anchor_id", "label": "Anchor id", "default": "testimonials" }
  ],
  "blocks": [
    {
      "type": "video",
      "name": "Testimonial video",
      "settings": [
        {
          "type": "text",
          "id": "video_url",
          "label": "YouTube link",
          "info": "Paste the share link — Shorts (youtube.com/shorts/…), youtu.be/… and watch?v=… all work. Vertical reels look best."
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "info": "Leave empty to use the video's own YouTube title."
        },
        {
          "type": "image_picker",
          "id": "poster",
          "label": "Custom thumbnail",
          "info": "Optional. Overrides the YouTube thumbnail — a 720×1280 image keeps the page lighter."
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Client testimonial",
      "blocks": [
        { "type": "video" },
        { "type": "video" },
        { "type": "video" },
        { "type": "video" },
        { "type": "video" }
      ]
    }
  ]
}
{% endschema %}
