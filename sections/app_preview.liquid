{%- comment -%}
  app_preview — "The App" collage of phone frames showing real app screenshots.
  Upload one screenshot per phone; a phone without an image shows a neutral
  placeholder. Styles in assets/app-page.css.
{%- endcomment -%}

{%- liquid
  assign s = section.settings
-%}

<section class="app-preview" id="{{ s.anchor_id | default: 'app-preview' }}">
  <div class="wrap">
    <div class="sec-head reveal">
      {%- if s.eyebrow != blank -%}
        <span class="eyebrow center">{{ s.eyebrow }}</span>
      {%- endif -%}
      {%- if s.heading != blank -%}
        <h2>{{ s.heading }}</h2>
      {%- endif -%}
      {%- if s.intro != blank -%}
        <p>{{ s.intro }}</p>
      {%- endif -%}
    </div>

    <div class="app-preview__collage reveal">
      {%- comment -%} Left phone {%- endcomment -%}
      <div class="app-phone app-phone--side app-phone--left">
        <div class="app-phone__screen">
          {%- if s.phone_left != blank -%}
            <img class="app-phone__shot" src="{{ s.phone_left | image_url: width: 600 }}" alt="{{ s.phone_left_alt | default: 'ORI app screenshot' | escape }}" loading="lazy" decoding="async" width="600" height="1280">
          {%- else -%}
            <div class="app-phone__placeholder" aria-hidden="true"><span>+</span></div>
          {%- endif -%}
        </div>
        <div class="app-phone__notch" aria-hidden="true"></div>
      </div>

      {%- comment -%} Centre phone {%- endcomment -%}
      <div class="app-phone app-phone--main">
        <div class="app-phone__screen">
          {%- if s.phone_main != blank -%}
            <img class="app-phone__shot" src="{{ s.phone_main | image_url: width: 700 }}" alt="{{ s.phone_main_alt | default: 'ORI app screenshot' | escape }}" loading="lazy" decoding="async" width="700" height="1493">
          {%- else -%}
            <div class="app-phone__placeholder" aria-hidden="true"><span>+</span></div>
          {%- endif -%}
        </div>
        <div class="app-phone__notch" aria-hidden="true"></div>
      </div>

      {%- comment -%} Right phone {%- endcomment -%}
      <div class="app-phone app-phone--side app-phone--right">
        <div class="app-phone__screen">
          {%- if s.phone_right != blank -%}
            <img class="app-phone__shot" src="{{ s.phone_right | image_url: width: 600 }}" alt="{{ s.phone_right_alt | default: 'ORI app screenshot' | escape }}" loading="lazy" decoding="async" width="600" height="1280">
          {%- else -%}
            <div class="app-phone__placeholder" aria-hidden="true"><span>+</span></div>
          {%- endif -%}
        </div>
        <div class="app-phone__notch" aria-hidden="true"></div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "app_preview",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "App Preview" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Every book, brought to life" },
    { "type": "textarea", "id": "intro", "label": "Intro", "default": "Browse all 66 books — cinematic chapters, guided tours and daily inspiration, all in one app." },
    { "type": "header", "content": "Left phone" },
    { "type": "image_picker", "id": "phone_left", "label": "Left screenshot" },
    { "type": "text", "id": "phone_left_alt", "label": "Left alt text", "default": "ORI app screenshot" },
    { "type": "header", "content": "Centre phone" },
    { "type": "image_picker", "id": "phone_main", "label": "Centre screenshot" },
    { "type": "text", "id": "phone_main_alt", "label": "Centre alt text", "default": "ORI app screenshot" },
    { "type": "header", "content": "Right phone" },
    { "type": "image_picker", "id": "phone_right", "label": "Right screenshot" },
    { "type": "text", "id": "phone_right_alt", "label": "Right alt text", "default": "ORI app screenshot" },
    { "type": "text", "id": "anchor_id", "label": "Anchor id", "default": "app-preview" }
  ],
  "presets": [{ "name": "app_preview" }]
}
{% endschema %}
