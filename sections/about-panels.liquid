{%- assign rotator_lines = section.settings.rotator_lines | split: '
' -%}
<section class="about wrap" id="{{ section.settings.anchor_id | default: 'about' }}">
  <div class="sec-head reveal">
    {%- if section.settings.eyebrow != blank -%}<span class="eyebrow center">{{ section.settings.eyebrow }}</span>{%- endif -%}
    {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading }}</h2>{%- endif -%}
    {%- if rotator_lines.size > 0 -%}
      <p class="about__rotator" id="about-rotator" data-lines="{{ rotator_lines | json | escape }}">{{ rotator_lines.first }}</p>
    {%- endif -%}
  </div>

  {%- for block in section.blocks -%}
    {%- assign row_parity = forloop.index0 | modulo: 2 -%}
    <article class="panel reveal{% if row_parity == 1 %} panel--reverse{% endif %}" {{ block.shopify_attributes }}>
      <div class="panel__text">
        {%- if block.settings.eyebrow != blank -%}<span class="eyebrow">{{ block.settings.eyebrow }}</span>{%- endif -%}
        {%- if block.settings.heading != blank -%}<h3>{{ block.settings.heading }}</h3>{%- endif -%}
        {%- if block.settings.text != blank -%}
          <p{% if block.settings.drop_cap %} class="lead"{% endif %}>{{ block.settings.text }}</p>
        {%- endif -%}
      </div>
      <div class="panel__media">
        {%- if block.settings.image != blank -%}
          <img src="{{ block.settings.image | image_url: width: 1300 }}" alt="{{ block.settings.image_alt | escape }}" loading="lazy" width="{{ block.settings.image.width }}" height="{{ block.settings.image.height }}">
        {%- elsif block.settings.image_url != blank -%}
          <img src="{{ block.settings.image_url }}" alt="{{ block.settings.image_alt | escape }}" loading="lazy" width="{{ block.settings.image.width }}" height="{{ block.settings.image.height }}">
        {%- endif -%}
      </div>
    </article>
  {%- endfor -%}
</section>

{%- if section.settings.show_ornament -%}
  <div class="ornament reveal wrap"><span></span><b>✦</b><span></span></div>
{%- endif -%}

{% schema %}
{
  "name": "About panels",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "About Vision of the Bible" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The greatest story, close enough to touch" },
    { "type": "textarea", "id": "rotator_lines", "label": "Rotating verses", "info": "One phrase per line. They fade through in turn.", "default": "“…that the Word of God would resonate in hearts and minds.”\n“…the timeless stories of the Bible, brought to life.”\n“…transforming lives and inspiring hope.”\n“…made for little hands and wise hearts alike.”" },
    { "type": "checkbox", "id": "show_ornament", "label": "Show ornament divider below", "default": true },
    { "type": "text", "id": "anchor_id", "label": "Anchor id", "default": "about" }
  ],
  "blocks": [
    {
      "type": "panel",
      "name": "Panel",
      "settings": [
        { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Our Story" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Bringing Scripture to life" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Vision of the Bible is devoted to bringing the timeless stories and profound truths of the Bible to life." },
        { "type": "checkbox", "id": "drop_cap", "label": "Drop cap on first letter", "default": false },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "image_url", "label": "Fallback image URL", "info": "Used if no image is uploaded above." },
        { "type": "text", "id": "image_alt", "label": "Image alt text" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [{ "name": "About panels" }]
}
{% endschema %}
