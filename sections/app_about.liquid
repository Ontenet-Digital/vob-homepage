{%- comment -%}
  app_about — "About ORI" for The App page.
  Centered heading + italic lede, then a landscape image beside an editorial
  text column with a centered "Explore More" CTA. Styles in assets/app-page.css.
{%- endcomment -%}

<section class="app-about" id="{{ section.settings.anchor_id | default: 'app-about' }}">
  <div class="wrap">
    <div class="sec-head reveal">
      {%- if section.settings.eyebrow != blank -%}
        <span class="eyebrow center">{{ section.settings.eyebrow }}</span>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2>{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.lede != blank -%}
        <p class="app-about__lede">{{ section.settings.lede }}</p>
      {%- endif -%}
    </div>

    <div class="app-about__grid reveal">
      <div class="app-about__media">
        {%- if section.settings.image != blank -%}
          <img
            src="{{ section.settings.image | image_url: width: 1200 }}"
            alt="{{ section.settings.image.alt | default: section.settings.heading | escape }}"
            loading="lazy"
            decoding="async"
            width="{{ section.settings.image.width }}"
            height="{{ section.settings.image.height }}">
        {%- elsif section.settings.image_url != blank -%}
          <img
            src="{{ section.settings.image_url }}"
            alt="{{ section.settings.heading | escape }}"
            loading="lazy"
            decoding="async"
            width="1200"
            height="900">
        {%- else -%}
          <div class="app-about__media-empty" aria-hidden="true"><span>✦</span></div>
        {%- endif -%}
      </div>

      <div class="app-about__copy">
        {%- if section.settings.text != blank -%}
          <div class="app-about__text">{{ section.settings.text }}</div>
        {%- endif -%}
        {%- if section.settings.button_label != blank and section.settings.button_link != blank -%}
          <div class="app-about__cta">
            <a class="btn app-about__btn" href="{{ section.settings.button_link }}">
              {{ section.settings.button_label }}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12h16"></path><path d="m13 5 7 7-7 7"></path></svg>
            </a>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "app_about",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "About" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "About ORI" },
    { "type": "textarea", "id": "lede", "label": "Lede (italic line)", "default": "Where faith and history intertwine, unveiling the Holy Land's secrets through mesmerizing cinematic storytelling." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Our team includes filmmakers, historians, and clergy from different denominations, all committed to sharing the wisdom of the Bible with everyone.\n\nDiscover the stories of all 66 books of the Bible like never before with our cinematic presentations. We make learning engaging and memorable by using moving footage, aerial shots, and beautiful locations. Join our guided tour series, Travel Samaria, to virtually experience sacred sites like Jerusalem and Capernaum.\n\nWe know how important it is to understand the Bible, so we've created a complete experience with scripture, music, images, and words. Whether you are young or old, our journey will deepen your faith and knowledge.\n\nCome with us on this transformative quest to explore the Holy Land and connect with its timeless wisdom. Together, let's embark on a journey of faith and discovery that you can carry with you wherever you go. Start your adventure with ORI Vision of the Bible today and experience the power of the scriptures firsthand." },
    { "type": "image_picker", "id": "image", "label": "Image", "info": "A wide scenic landscape works best (4:3)." },
    { "type": "text", "id": "image_url", "label": "Image URL (fallback)" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Explore More" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "text", "id": "anchor_id", "label": "Anchor id", "default": "app-about" }
  ],
  "presets": [{ "name": "app_about" }]
}
{% endschema %}
