<header class="site-header" role="banner">
  <nav class="nav wrap" aria-label="Primary">
    <a class="brand" href="{{ routes.root_url }}" aria-label="{{ shop.name }} home">
      {%- if settings.logo_light != blank -%}
        <img class="brand__logo" src="{{ settings.logo_light | image_url: width: 300 }}" alt="{{ shop.name | escape }}" width="150" height="42">
      {%- else -%}
        {% render 'emblem', class: 'brand__mark' %}
        <span class="brand__word">
          <span class="a">{{ section.settings.brand_line_1 | default: 'Vision of the' }}</span>
          <span class="b">{{ section.settings.brand_line_2 | default: 'Bible' }}</span>
          {%- if section.settings.brand_tagline != blank -%}
            <small>{{ section.settings.brand_tagline }}</small>
          {%- endif -%}
        </span>
      {%- endif -%}
    </a>

    <div class="nav__links" id="nav-links">
      {%- for block in section.blocks -%}
        {%- if block.type == 'link' -%}
          <a href="{{ block.settings.link | default: '#' }}" {{ block.shopify_attributes }}>{{ block.settings.label }}</a>
        {%- endif -%}
      {%- endfor -%}
    </div>

    <div class="nav__actions">
      <a class="nav__icon" href="{{ routes.account_url }}" aria-label="Account">
        <svg
          width="48"
          height="48"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <circle cx="12" cy="8" r="4"/>
          <path d="M4 21c0-4 4-6 8-6s8 2 8 6"/>
        </svg>
      </a>
      <a class="nav__icon" href="{{ routes.cart_url }}" aria-label="Cart" data-cart-toggle aria-controls="cart-drawer" aria-expanded="false">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M6 6h15l-1.5 9h-12z"/><path d="M6 6 5 3H2"/><circle cx="9" cy="20" r="1.4"/><circle cx="18" cy="20" r="1.4"/></svg>
        <span class="nav__count" data-cart-count {% if cart.item_count == 0 %}hidden{% endif %}>{{ cart.item_count }}</span>
      </a>
      <button class="nav__toggle" type="button" aria-label="Menu" aria-controls="nav-links" aria-expanded="false">
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
      </button>
    </div>
  </nav>
</header>

{% schema %}
{
  "name": "Header",
  "settings": [
    { "type": "header", "content": "Wordmark", "info": "Shown only when no light logo is set in Theme settings › Brand." },
    { "type": "text", "id": "brand_line_1", "label": "Brand line 1", "default": "Vision of the" },
    { "type": "text", "id": "brand_line_2", "label": "Brand line 2 (accent)", "default": "Bible" },
    { "type": "text", "id": "brand_tagline", "label": "Tagline", "default": "Sacred stories brought to life" }
  ],
  "blocks": [
    {
      "type": "link",
      "name": "Menu link",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Menu item" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "max_blocks": 6,
  "default": {
    "blocks": [
      { "type": "link", "settings": { "label": "Our Story", "link": "#about" } },
      { "type": "link", "settings": { "label": "Products", "link": "#products" } },
      { "type": "link", "settings": { "label": "The App", "link": "#app" } }
    ]
  }
}
{% endschema %}
