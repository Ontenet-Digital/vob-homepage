<div class="page-shell wrap">
  <div class="page-head">
    <span class="eyebrow">{{ 'general.search.search' | t }}</span>
    <h1>{{ 'general.search.search' | t }}</h1>
  </div>

  <form action="{{ routes.search_url }}" method="get" role="search" class="auth-form" style="margin:0 0 2.4rem">
    <input type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'general.search.placeholder' | t }}" aria-label="{{ 'general.search.search' | t }}">
    <button type="submit" class="btn btn--primary">{{ 'general.search.search' | t }}</button>
  </form>

  {%- if search.performed -%}
    {%- if search.results.size > 0 -%}
      <p class="form-note" style="margin-bottom:1.4rem">{{ 'general.search.results_with_count' | t: terms: search.terms, count: search.results_count }}</p>
      <div class="grid-products">
        {%- for item in search.results -%}
          {%- if item.object_type == 'product' -%}
            {% render 'product-card', product: item %}
          {%- else -%}
            <div class="grid-card"><a class="grid-card__link" href="{{ item.url }}"><div class="grid-card__body"><h3>{{ item.title }}</h3></div></a></div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- else -%}
      <div class="empty-state"><p class="rte">{{ 'general.search.no_results' | t: terms: search.terms }}</p></div>
    {%- endif -%}
  {%- endif -%}
</div>

{% schema %}
{ "name": "Search", "settings": [] }
{% endschema %}
