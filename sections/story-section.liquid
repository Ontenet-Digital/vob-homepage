<section class="story-section wrap" id="{{ section.settings.anchor_id | default: 'journal' }}">
  <div class="sec-head reveal">
    {%- if section.settings.eyebrow != blank -%}
      <span class="eyebrow eyebrow-center">{{ section.settings.eyebrow }}</span>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h2>{{ section.settings.heading }}</h2>
    {%- endif -%}
    {%- if section.settings.subheading != blank -%}
      <p>{{ section.settings.subheading }}</p>
    {%- endif -%}
  </div>
  <div class="blog__grid">
    {%- if section.settings.blog != blank and blogs[section.settings.blog].articles_count > 0 -%}
      {%- assign posts = blogs[section.settings.blog].articles -%}
      {%- for article in posts limit: section.settings.post_limit -%}
        <a class="post reveal" href="{{ article.url }}">
          <div class="post__media">
            {%- if article.image -%}
              <img
                src="{{ article.image | image_url: width: 900 }}"
                alt="{{ article.image.alt | default: article.title | escape }}"
                loading="lazy"
                width="900"
                height="900"
                style="width: 100%; height: 100%; object-fit: cover;"
              >
            {%- endif -%}
          </div>
          <div class="post__body">
            {%- if article.tags.size > 0 -%}
              <span class="post__tag">{{ article.tags.first }}</span>
            {%- endif -%}
            <h3>{{ article.title }}</h3>
            <p>{{ article.excerpt_or_content | strip_html | truncatewords: 22 }}</p>
          </div>
        </a>
      {%- endfor -%}
    {%- else -%}
      {%- for block in section.blocks -%}
        <a class="post reveal" href="{{ block.settings.link | default: '#' }}" {{ block.shopify_attributes }}>
          <div class="post__media">
            {%- if block.settings.image != blank -%}
              <img
                src="{{ block.settings.image | image_url: width: 900 }}"
                alt="{{ block.settings.title | escape }}"
                loading="lazy"
                width="900"
                height="900"
                style="width: 100%; height: 100%; object-fit: cover;"
              >
            {%- elsif block.settings.image_url != blank -%}
              <img
                src="{{ block.settings.image_url }}"
                alt="{{ block.settings.title | escape }}"
                loading="lazy"
                width="900"
                height="900"
                style="width: 100%; height: 100%; object-fit: cover;"
              >
            {%- endif -%}
          </div>
          <div class="post__body">
            {%- if block.settings.tag != blank -%}
              <span class="post__tag">{{ block.settings.tag }}</span>
            {%- endif -%}
            {%- if block.settings.title != blank -%}
              <h3>{{ block.settings.title }}</h3>
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <p>{{ block.settings.text }}</p>
            {%- endif -%}
          </div>
        </a>
      {%- endfor -%}
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Story section",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "From the journal" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Stories, faith & family" },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Reflections and ideas from the Vision of the Bible stories family."
    },
    {
      "type": "blog",
      "id": "blog",
      "label": "Blog",
      "info": "Optional. If chosen, its latest articles are shown instead of the manual cards below."
    },
    { "type": "range", "id": "post_limit", "min": 2, "max": 6, "step": 1, "label": "Articles to show", "default": 3 },
    { "type": "text", "id": "anchor_id", "label": "Anchor id", "default": "journal" }
  ],
  "blocks": [
    {
      "type": "post",
      "name": "Post card",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "image_url", "label": "Fallback image URL" },
        { "type": "text", "id": "tag", "label": "Tag", "default": "Faith at home" },
        { "type": "text", "id": "title", "label": "Title", "default": "Post title" },
        { "type": "textarea", "id": "text", "label": "Excerpt" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [{ "name": "Story section" }]
}
{% endschema %}
