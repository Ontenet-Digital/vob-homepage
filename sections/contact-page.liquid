{%- comment -%}
  contact-page — dedicated, customizable Contact page template.

  Renders an editorial header (customizable eyebrow + heading + optional
  subtitle) followed by the native contact form (snippets/contact-form.liquid).

  - Header copy (eyebrow, title, subtitle) is editable in the theme editor.
  - Styles: assets/contact-page.css (loaded from layout/theme.liquid).
  - Form AJAX submit: assets/theme-contact.js.

  Assign the "page.contact" template to your Contact page in Pages admin.
{%- endcomment -%}

<section class="contact-page">
  <div class="wrap">
    <header class="contact-page__head contact-page__head--{{ section.settings.align }}">
      {%- if section.settings.eyebrow != blank -%}
        <span class="eyebrow">{{ section.settings.eyebrow }}</span>
      {%- endif -%}

      {%- assign heading = section.settings.title | default: page.title -%}
      <h1 class="contact-page__title">{{ heading }}</h1>

      {%- if section.settings.subtitle != blank -%}
        <div class="contact-page__subtitle rte">{{ section.settings.subtitle }}</div>
      {%- endif -%}
    </header>

    <div class="contact-page__form">
      {% render 'contact-form' %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Contact page",
  "tag": "section",
  "class": "contact-page-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "Vision of the Bible"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Page heading",
      "default": "Contact",
      "info": "Leave blank to use the page title from Pages admin."
    },
    {
      "type": "richtext",
      "id": "subtitle",
      "label": "Subtitle (optional)"
    },
    {
      "type": "select",
      "id": "align",
      "label": "Heading alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        }
      ],
      "default": "left"
    }
  ],
  "presets": [
    {
      "name": "Contact page"
    }
  ]
}
{% endschema %}
