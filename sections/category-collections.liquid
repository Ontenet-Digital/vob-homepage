<section class="cats wrap" id="{{ section.settings.anchor_id | default: 'categories' }}">
  <div class="sec-head reveal">
    {%- if section.settings.eyebrow != blank -%}
      <span class="eyebrow eyebrow-center">{{ section.settings.eyebrow }}</span>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h2>{{ section.settings.heading }}</h2>
    {%- endif -%}
    {%- if section.settings.subheading != blank -%}
      <p>{{ section.settings.subheading }}</p>
    {%- endif -%}
  </div>
  <div class="cats__grid">
    {%- for block in section.blocks -%}
      <a class="cat reveal" href="{{ block.settings.link | default: '#' }}" {{ block.shopify_attributes }}>
        <div class="cat__media">
          {%- if block.settings.image != blank -%}
            <img
              src="{{ block.settings.image | image_url: width: 900 }}"
              alt="{{ block.settings.title | escape }}"
              loading="lazy"
              width="{{ block.settings.image.width }}"
              height="{{ block.settings.image.height }}"
            >
          {%- elsif block.settings.image_url != blank -%}
            <img
              src="{{ block.settings.image_url }}"
              alt="{{ block.settings.title | escape }}"
              loading="lazy"
              width="{{ block.settings.image.width }}"
              height="{{ block.settings.image.height }}"
            >
          {%- endif -%}
        </div>
        <div class="cat__body">
          {%- if block.settings.title != blank -%}
            <p>{{ block.settings.title }}</p>
          {%- endif -%}
        </div>
      </a>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Category collections",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Explore by collection" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Find the right journey" },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Four ways into the same story — choose the one that fits the hands it’s for."
    },
    { "type": "text", "id": "anchor_id", "label": "Anchor id", "default": "categories" }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "image_url", "label": "Fallback image URL" },
        { "type": "text", "id": "title", "label": "Title", "default": "Kids" },
        { "type": "text", "id": "subtitle", "label": "Subtitle", "default": "Animated Bible stories for little ones" },
        { "type": "text", "id": "link_label", "label": "Link label", "default": "Explore" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [{ "name": "Category collections" }]
}
{% endschema %}
