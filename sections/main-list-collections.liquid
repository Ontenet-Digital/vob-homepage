<div class="page-shell wrap">
  <div class="page-head">
    <span class="eyebrow">Explore</span>
    <h1>{{ page_title | default: 'Collections' }}</h1>
  </div>
  <div class="grid-products">
    {%- for collection in collections -%}
      <a class="grid-card" href="{{ collection.url }}">
        <div class="grid-card__media">
          {%- if collection.featured_image -%}
            <img src="{{ collection.featured_image | image_url: width: 600 }}" alt="{{ collection.title | escape }}" loading="lazy">
          {%- endif -%}
        </div>
        <div class="grid-card__body"><h3>{{ collection.title }}</h3></div>
      </a>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{ "name": "Collections list", "settings": [] }
{% endschema %}
