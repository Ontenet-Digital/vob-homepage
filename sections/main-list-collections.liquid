{%- comment -%}
  Shopify serves /collections as a collection index. This store uses a single
  all-products grid at /collections/all instead — send anyone who lands here
  straight to that page.
{%- endcomment -%}
<meta http-equiv="refresh" content="0;url={{ routes.all_products_collection_url }}">
<link rel="canonical" href="{{ routes.all_products_collection_url }}">
<div class="plist wrap">
  <p class="plist__sub">
    Redirecting to
    <a href="{{ routes.all_products_collection_url }}">Products</a>…
  </p>
</div>

{% schema %}
{ "name": "Collections list", "settings": [] }
{% endschema %}
