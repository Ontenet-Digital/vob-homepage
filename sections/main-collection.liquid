<div class="page-shell wrap">
  <div class="page-head">
    <span class="eyebrow">Collection</span>
    <h1>{{ collection.title }}</h1>
    {%- if collection.description != blank -%}<div class="rte" style="margin-top:1rem">{{ collection.description }}</div>{%- endif -%}
  </div>

  {%- if collection.products.size > 0 -%}
    {%- paginate collection.products by 24 -%}
      <div class="grid-products">
        {%- for product in collection.products -%}
          {% render 'product-card', product: product %}
        {%- endfor -%}
      </div>
      {%- if paginate.pages > 1 -%}
        <div class="breadcrumb" style="margin-top:2rem">{{ paginate | default_pagination }}</div>
      {%- endif -%}
    {%- endpaginate -%}
  {%- else -%}
    <div class="empty-state"><p class="rte">No products found in this collection yet.</p></div>
  {%- endif -%}
</div>

{% schema %}
{ "name": "Collection page", "settings": [] }
{% endschema %}
