<section class="apps wrap" id="{{ section.settings.anchor_id | default: 'app' }}">
    <div class="apps__panel reveal">
      <div class="apps__grid">
        <div class="apps__text">
          {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
          {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading }}</h2>{%- endif -%}
          {%- if section.settings.text != blank -%}<p>{{ section.settings.text }}</p>{%- endif -%}
          <div class="stores">
            {%- if section.settings.appstore_link != blank -%}
              <a class="store" href="{{ section.settings.appstore_link }}"{% if section.settings.appstore_link contains 'http' %} target="_blank" rel="noopener"{% endif %}>
                <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M16.5 2.1c.1 1-.3 2-1 2.8-.7.8-1.7 1.4-2.7 1.3-.1-1 .4-2 1-2.7.7-.8 1.8-1.4 2.7-1.4zM19.6 17.3c-.5 1.2-.8 1.7-1.5 2.7-.9 1.4-2.3 3.1-3.9 3.1-1.5 0-1.8-1-3.8-1-1.9 0-2.3 1-3.8 1-1.6 0-2.9-1.6-3.8-2.9C-.4 16.3-.7 11 1.3 8.2c1-1.4 2.5-2.2 4-2.2 1.5 0 2.5 1 3.8 1 1.2 0 1.9-1 3.7-1 1.3 0 2.7.7 3.7 1.9-3.3 1.8-2.7 6.4.6 8.6z"/></svg>
                <span class="s"><b>App Store</b><span>Download on the</span></span>
              </a>
            {%- endif -%}
            {%- if section.settings.googleplay_link != blank -%}
              <a class="store" href="{{ section.settings.googleplay_link }}"{% if section.settings.googleplay_link contains 'http' %} target="_blank" rel="noopener"{% endif %}>
                <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M3.6 2.3c-.3.2-.5.6-.5 1.1v17.2c0 .5.2.9.5 1.1l9.2-9.7L3.6 2.3zm10.3 10.8l2.6 2.7-10.8 6.1 8.2-8.8zm3.9-4.1l2.4 1.4c.7.4.7 1.4 0 1.8l-2.5 1.4-2.8-2.9 2.9-1.7zM5.7 1.9l10.8 6.1-2.6 2.7-8.2-8.8z"/></svg>
                <span class="s"><b>Google Play</b><span>Get it on</span></span>
              </a>
            {%- endif -%}
          </div>
        </div>
        <div class="phones">
          <div class="phone"><div class="phone__screen"><div class="phone__notch"></div>
            {%- if section.settings.phone_1 != blank -%}
              <img src="{{ section.settings.phone_1 | image_url: width: 800 }}" alt="{{ section.settings.phone_1_alt | escape }}" loading="lazy" width="800" height="800" style="width: 100%; height: 100%; object-fit: cover;">
            {%- elsif section.settings.phone_1_url != blank -%}
              <img src="{{ section.settings.phone_1_url }}" alt="{{ section.settings.phone_1_alt | escape }}" loading="lazy" width="800" height="800" style="width: 100%; height: 100%; object-fit: cover;">
            {%- endif -%}
          </div></div>
          <div class="phone"><div class="phone__screen"><div class="phone__notch"></div>
            {%- if section.settings.phone_2 != blank -%}
              <img src="{{ section.settings.phone_2 | image_url: width: 800 }}" alt="{{ section.settings.phone_2_alt | escape }}" loading="lazy" width="800" height="800" style="width: 100%; height: 100%; object-fit: cover;">
            {%- elsif section.settings.phone_2_url != blank -%}
              <img src="{{ section.settings.phone_2_url }}" alt="{{ section.settings.phone_2_alt | escape }}" loading="lazy" width="800" height="800" style="width: 100%; height: 100%; object-fit: cover;">
            {%- endif -%}
          </div></div>
        </div>
      </div>
    </div>
  </section>
  
  {% schema %}
  {
    "name": "App promo",
    "tag": "section",
    "settings": [
      { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The app we offer" },
      { "type": "text", "id": "heading", "label": "Heading", "default": "Carry the Word in your pocket" },
      { "type": "textarea", "id": "text", "label": "Text", "default": "Explore the Bible like never before — captivating videos, powerful narration, and easy-to-follow subtitles, all in one gentle, distraction-free app. The same immersive storytelling that fills our tablets, ready wherever your family goes." },
      { "type": "header", "content": "App stores" },
      { "type": "url", "id": "appstore_link", "label": "App Store link" },
      { "type": "url", "id": "googleplay_link", "label": "Google Play link" },
      { "type": "header", "content": "Phone screenshots" },
      { "type": "image_picker", "id": "phone_1", "label": "Phone 1 image" },
      { "type": "text", "id": "phone_1_url", "label": "Phone 1 fallback URL" },
      { "type": "text", "id": "phone_1_alt", "label": "Phone 1 alt text", "default": "The immersive Bible app showing an animated New Testament scene" },
      { "type": "image_picker", "id": "phone_2", "label": "Phone 2 image" },
      { "type": "text", "id": "phone_2_url", "label": "Phone 2 fallback URL" },
      { "type": "text", "id": "phone_2_alt", "label": "Phone 2 alt text", "default": "The immersive Bible app showing an animated Old Testament scene" },
      { "type": "text", "id": "anchor_id", "label": "Anchor id", "default": "app" }
    ],
    "presets": [{ "name": "App promo" }]
  }
  {% endschema %}
  