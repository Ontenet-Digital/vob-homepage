              </svg>
              <span class="s"><span>Get it on</span><b>App Store</b></span>
            </a>
          {%- endif -%}
          {%- if section.settings.googleplay_link != blank -%}
            <a
              class="store"
              href="{{ section.settings.googleplay_link }}"
              {% if section.settings.googleplay_link contains 'http' %}
                target="_blank" rel="noopener"
              {% endif %}
            >
              <svg
                id="Icons"
                enable-background="new 0 0 32 32"
                viewBox="0 0 32 32"
                xmlns="http://www.w3.org/2000/svg"
                style="fill:white;"
              >
                <g><path d="m17 14.5 4.2-4.5-16.3-8.8c-.1-.1-.3-.1-.6-.2z"/><path d="m23 21 5.9-3.2c.7-.4 1.1-1 1.1-1.8s-.4-1.5-1.1-1.8l-5.9-3.2-4.7 5z"/><path d="m2.4 1.9c-.3.3-.4.7-.4 1.1v26c0 .4.1.8.4 1.2l13.2-14.2z"/><path d="m17 17.5-12.7 13.5c.2 0 .4-.1.6-.2l16.3-8.8z"/></g>
              </svg>
              <span class="s"><span>Get it on</span><b>Google Play</b></span>
            </a>
          {%- endif -%}
        </div>
      </div>
      <div class="phones mobile--hidden">
        <div class="phone">
          <div class="phone__screen">
            <div class="phone__notch"></div>
            {%- if section.settings.phone_1 != blank -%}
              <img
                src="{{ section.settings.phone_1 | image_url: width: 800 }}"
                alt="{{ section.settings.phone_1_alt | escape }}"
                loading="lazy"
                width="800"
                height="800"
                style="width: 100%; height: 100%; object-fit: cover;"
              >
            {%- elsif section.settings.phone_1_url != blank -%}
              <img
                src="{{ section.settings.phone_1_url }}"
                alt="{{ section.settings.phone_1_alt | escape }}"
                loading="lazy"
                width="800"
                height="800"
                style="width: 100%; height: 100%; object-fit: cover;"
              >
            {%- endif -%}
          </div>
        </div>
        <div class="phone">
          <div class="phone__screen">
            <div class="phone__notch"></div>
            {%- if section.settings.phone_2 != blank -%}
              <img
                src="{{ section.settings.phone_2 | image_url: width: 800 }}"
                alt="{{ section.settings.phone_2_alt | escape }}"
                loading="lazy"
                width="800"
                height="800"
                style="width: 100%; height: 100%; object-fit: cover;"
              >
            {%- elsif section.settings.phone_2_url != blank -%}
              <img
                src="{{ section.settings.phone_2_url }}"
                alt="{{ section.settings.phone_2_alt | escape }}"
                loading="lazy"
                width="800"
                height="800"
                style="width: 100%; height: 100%; object-fit: cover;"
              >
            {%- endif -%}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "App promo",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The app we offer" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Carry the Word in your pocket" },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Explore the Bible like never before — captivating videos, powerful narration, and easy-to-follow subtitles, all in one gentle, distraction-free app. The same immersive storytelling that fills our tablets, ready wherever your family goes."
    },
    { "type": "header", "content": "App stores" },
    { "type": "url", "id": "appstore_link", "label": "App Store link" },
    { "type": "url", "id": "googleplay_link", "label": "Google Play link" },
    { "type": "header", "content": "Phone screenshots" },
    { "type": "image_picker", "id": "phone_1", "label": "Phone 1 image" },
    { "type": "text", "id": "phone_1_url", "label": "Phone 1 fallback URL" },
    {
      "type": "text",
      "id": "phone_1_alt",
      "label": "Phone 1 alt text",
      "default": "The immersive Bible app showing an animated New Testament scene"
    },
    { "type": "image_picker", "id": "phone_2", "label": "Phone 2 image" },
    { "type": "text", "id": "phone_2_url", "label": "Phone 2 fallback URL" },
    {
      "type": "text",
      "id": "phone_2_alt",
      "label": "Phone 2 alt text",
      "default": "The immersive Bible app showing an animated Old Testament scene"
    },
    { "type": "text", "id": "anchor_id", "label": "Anchor id", "default": "app" }
  ],
  "presets": [{ "name": "App promo" }]
}
{% endschema %}
