<section class="apps wrap" id="{{ section.settings.anchor_id | default: 'app' }}">
  <div class="apps__panel reveal">
    <div class="apps__grid">
      <div class="apps__text">
        {%- if section.settings.eyebrow != blank -%}
          <span class="eyebrow eyebrow-left">{{ section.settings.eyebrow }}</span>
        {%- endif -%}

        <div class="phones desktop--hidden">
          <div class="phone">
            <div class="phone__screen">
              <div class="phone__notch"></div>
              {%- if section.settings.phone_1 != blank -%}
                <img
                  src="{{ section.settings.phone_1 | image_url: width: 800 }}"
                  alt="{{ section.settings.phone_1_alt | escape }}"
                  loading="lazy"
                  width="800"
                  height="800"
                  style="width: 100%; height: 100%; object-fit: cover;"
                >
              {%- elsif section.settings.phone_1_url != blank -%}
                <img
                  src="{{ section.settings.phone_1_url }}"
                  alt="{{ section.settings.phone_1_alt | escape }}"
                  loading="lazy"
                  width="800"
                  height="800"
                  style="width: 100%; height: 100%; object-fit: cover;"
                >
              {%- endif -%}
            </div>
          </div>
          <div class="phone">
            <div class="phone__screen">
              <div class="phone__notch"></div>
              {%- if section.settings.phone_2 != blank -%}
                <img
                  src="{{ section.settings.phone_2 | image_url: width: 800 }}"
                  alt="{{ section.settings.phone_2_alt | escape }}"
                  loading="lazy"
                  width="800"
                  height="800"
                  style="width: 100%; height: 100%; object-fit: cover;"
                >
              {%- elsif section.settings.phone_2_url != blank -%}
                <img
                  src="{{ section.settings.phone_2_url }}"
                  alt="{{ section.settings.phone_2_alt | escape }}"
                  loading="lazy"
                  width="800"
                  height="800"
                  style="width: 100%; height: 100%; object-fit: cover;"
                >
              {%- endif -%}
            </div>
          </div>
        </div>

        {%- if section.settings.heading != blank -%}
          <h2>{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <p>{{ section.settings.text }}</p>
        {%- endif -%}
        <div class="stores">
          {%- if section.settings.appstore_link != blank -%}
            <a
              class="store"
              href="{{ section.settings.appstore_link }}"
              {% if section.settings.appstore_link contains 'http' %}
                target="_blank" rel="noopener"
              {% endif %}
            >
              <svg
                version="1.1"
                id="Capa_1"
                xmlns="http://www.w3.org/2000/svg"
                xmlns:xlink="http://www.w3.org/1999/xlink"
                x="0px"
                y="0px"
                viewBox="0 0 22.773 22.773"
                style="enable-background:new 0 0 22.773 22.773; fill:white;"
                xml:space="preserve"
              >
                <g>
                	<g>
                		<path d="M15.769,0c0.053,0,0.106,0,0.162,0c0.13,1.606-0.483,2.806-1.228,3.675c-0.731,0.863-1.732,1.7-3.351,1.573
                			c-0.108-1.583,0.506-2.694,1.25-3.561C13.292,0.879,14.557,0.16,15.769,0z"/>
                		<path d="M20.67,16.716c0,0.016,0,0.03,0,0.045c-0.455,1.378-1.104,2.559-1.896,3.655c-0.723,0.995-1.609,2.334-3.191,2.334
                			c-1.367,0-2.275-0.879-3.676-0.903c-1.482-0.024-2.297,0.735-3.652,0.926c-0.155,0-0.31,0-0.462,0
                			c-0.995-0.144-1.798-0.932-2.383-1.642c-1.725-2.098-3.058-4.808-3.306-8.276c0-0.34,0-0.679,0-1.019
                			c0.105-2.482,1.311-4.5,2.914-5.478c0.846-0.52,2.009-0.963,3.304-0.765c0.555,0.086,1.122,0.276,1.619,0.464
                			c0.471,0.181,1.06,0.502,1.618,0.485c0.378-0.011,0.754-0.208,1.135-0.347c1.116-0.403,2.21-0.865,3.652-0.648
                			c1.733,0.262,2.963,1.032,3.723,2.22c-1.466,0.933-2.625,2.339-2.427,4.74C17.818,14.688,19.086,15.964,20.67,16.716z"/>
                	</g>
                	<g>
